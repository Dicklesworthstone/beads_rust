+/// Open every directory component without following links, retaining the final
+/// descriptor so permission changes cannot be redirected through a pathname.
+#[cfg(unix)]
+fn open_recovery_directory_nofollow(path: &Path) -> Result<fs::File> {
+    use rustix::fs::{CWD, Mode, OFlags, openat};
+    use std::path::Component;
+
+    let flags = OFlags::RDONLY | OFlags::DIRECTORY | OFlags::NOFOLLOW | OFlags::CLOEXEC;
+    let anchor = if path.is_absolute() { "/" } else { "." };
+    let mut directory =
+        fs::File::from(openat(CWD, anchor, flags, Mode::empty()).map_err(std::io::Error::from)?);
+    for component in path.components() {
+        match component {
+            Component::Normal(name) => {
+                directory = fs::File::from(
+                    openat(&directory, name, flags, Mode::empty()).map_err(std::io::Error::from)?,
+                );
+            }
+            Component::RootDir | Component::CurDir => {}
+            _ => {
+                return Err(BeadsError::Config(format!(
+                    "Refusing ambiguous recovery directory route '{}'",
+                    path.display()
+                )));
+            }
+        }
+    }
+    Ok(directory)
+}
+
+/// Create private recovery storage independently of the process umask. Older
+/// versions created 0775 directories under umask 002; tighten only directories
+/// owned by this effective user and never a world-writable or redirected path.
+#[cfg(unix)]
+fn ensure_recovery_directory(path: &Path) -> Result<()> {
+    use rustix::fs::{AtFlags, Mode, fstat, mkdirat, statat};
+    use rustix::io::Errno;
+    use std::os::unix::fs::{MetadataExt, PermissionsExt};
+
+    crate::sync::reject_symlinked_database_route_components(&path.join(".recovery"))?;
+    let parent_path = path
+        .parent()
+        .ok_or_else(|| BeadsError::Config("Recovery directory has no parent".to_string()))?;
+    let name = path
+        .file_name()
+        .ok_or_else(|| BeadsError::Config("Recovery directory has no filename".to_string()))?;
+    let parent = open_recovery_directory_nofollow(parent_path)?;
+    match mkdirat(&parent, name, Mode::RWXU) {
+        Ok(()) | Err(Errno::EXIST) => {}
+        Err(error) => return Err(BeadsError::Io(error.into())),
+    }
+    let before = statat(&parent, name, AtFlags::SYMLINK_NOFOLLOW).map_err(std::io::Error::from)?;
+    let directory = open_recovery_directory_nofollow(path)?;
+    let opened = fstat(&directory).map_err(std::io::Error::from)?;
+    let metadata = directory.metadata()?;
+    if before.st_dev != opened.st_dev
+        || before.st_ino != opened.st_ino
+        || metadata.uid() != rustix::process::geteuid().as_raw()
+        || metadata.mode() & 0o002 != 0
+    {
+        return Err(BeadsError::Config(format!(
+            "Refusing recovery directory '{}': changed identity, foreign owner, or world-writable permissions",
+            path.display()
+        )));
+    }
+
+    // Use the descriptor, never chmod(path), and only REMOVE permission bits.
+    // Do not change member files: old or unsafe evidence is still ineligible
+    // for receipt-based pruning, even after its directory becomes private.
+    let private_mode = metadata.mode() & 0o700;
+    if metadata.mode() & 0o7777 != private_mode {
+        directory.set_permissions(fs::Permissions::from_mode(private_mode))?;
+    }
+    directory.sync_all()?;
+    parent.sync_all()?;
+    let current = open_recovery_directory_nofollow(path)?.metadata()?;
+    let held = directory.metadata()?;
+    if current.dev() != metadata.dev()
+        || current.ino() != metadata.ino()
+        || held.uid() != metadata.uid()
+        || held.mode() & 0o7777 != private_mode
+        || current.uid() != held.uid()
+        || current.mode() != held.mode()
+    {
+        return Err(BeadsError::Config(format!(
+            "Recovery directory '{}' changed while securing it",
+            path.display()
+        )));
+    }
+    Ok(())
+}
