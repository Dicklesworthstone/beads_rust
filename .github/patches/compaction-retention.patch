+    )
+    .expect("competing database authority");
+    let blocked = run_br(
+        workspace,
+        ["--lock-timeout", "100", "sync", "--import-only", "--json"],
+        "compaction_import_blocked",
+    );
+    assert_eq!(blocked.status.code(), Some(2), "{}", blocked.stderr);
+    let error: serde_json::Value = serde_json::from_str(&blocked.stdout).expect("refusal JSON");
+    assert_eq!(error["error"]["code"], "DATABASE_LOCKED", "{error}");
+    assert_eq!(
+        error["error"]["context"]["lock_role"], "database-family write lock",
+        "{error}"
+    );
+    authority
+        .verify_database_authority()
+        .expect("authority remains held");
+    assert_eq!(
+        DirectorySnapshot::capture(&recovery_dir).files,
+        recovery_before.files,
+        "a refused compaction must preserve every recovery copy and receipt"
+    );
+    assert_eq!(
+        fs::read(jsonl_path).expect("pending import remains"),
+        jsonl_before,
+        "refusal must preserve the pending JSONL import"
+    );
+    // No main-database descriptor is opened while this process owns its POSIX
+    // lock. Release authority before the successful retry or any engine open.
+    drop(authority);
+}
