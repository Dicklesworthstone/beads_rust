+#[cfg(any(target_os = "linux", target_os = "android", target_vendor = "apple"))]
+fn completed_compaction_receipts(beads_dir: &Path) -> BTreeMap<String, Vec<u8>> {
+    let recovery_dir = beads_dir.join(".br_recovery");
+    let entries = match fs::read_dir(&recovery_dir) {
+        Ok(entries) => entries,
+        Err(error) if error.kind() == std::io::ErrorKind::NotFound => return BTreeMap::new(),
+        Err(error) => panic!("read recovery directory: {error}"),
+    };
+    entries
+        .map(|entry| entry.expect("recovery entry"))
+        .filter_map(|entry| {
+            let name = entry.file_name().into_string().expect("fixture filename");
+            if name.starts_with("beads.db.vacuum-") && name.ends_with(".complete.json") {
+                Some((name, fs::read(entry.path()).expect("completion receipt")))
+            } else {
+                None
+            }
+        })
+        .collect()
+}
