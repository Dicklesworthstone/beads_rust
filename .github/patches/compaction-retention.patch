+#[cfg(any(target_os = "linux", target_os = "android", target_vendor = "apple"))]
+fn assert_completed_compaction_family(
+    db_path: &Path,
+    marker: &str,
+    contents: &[u8],
+    started: chrono::DateTime<chrono::Utc>,
+) {
+    use std::collections::BTreeSet;
+    use std::os::unix::fs::MetadataExt;
+
+    let receipt: serde_json::Value = serde_json::from_slice(contents).expect("receipt JSON");
+    assert_eq!(receipt["schema_version"], "br.compaction.complete.v3");
+    assert_eq!(receipt["integrity_check"], "ok");
+    assert_eq!(receipt["source_integrity_check"], "ok");
+    assert_eq!(receipt["database_path"].as_str(), db_path.to_str());
+    let completed = chrono::DateTime::parse_from_rfc3339(
+        receipt["completed_at"]
+            .as_str()
+            .expect("completion timestamp"),
+    )
+    .expect("valid completion timestamp")
+    .with_timezone(&chrono::Utc);
+    assert!(
+        (started..=chrono::Utc::now()).contains(&completed),
+        "this run must produce fresh completion evidence: {receipt}"
+    );
+    let stamp = receipt["stamp"].as_str().expect("compaction stamp");
+    assert_eq!(marker, format!("beads.db.{stamp}.complete.json"));
+    let members = receipt["members"].as_array().expect("family members");
+    let suffixes: BTreeSet<_> = members
+        .iter()
+        .map(|member| member["suffix"].as_str().expect("member suffix"))
+        .collect();
+    assert_eq!(suffixes.len(), members.len(), "no duplicate member");
+    assert!(suffixes.contains(""), "main database must be retained");
+    let recovery_dir = db_path.parent().unwrap().join(".br_recovery");
+    let mut expected_names = BTreeSet::from([marker.to_string()]);
+    for member in members {
+        let suffix = member["suffix"].as_str().unwrap();
+        let name = format!("beads.db{suffix}.{stamp}.bak");
+        let backup = recovery_dir.join(&name);
+        let metadata = fs::symlink_metadata(&backup).expect("retained member metadata");
+        assert!(metadata.is_file(), "retained member must be a regular file");
+        let witness = &member["witness"];
+        assert_eq!(witness["length"].as_u64(), Some(metadata.len()));
+        assert_eq!(witness["device"].as_u64(), Some(metadata.dev()));
+        assert_eq!(witness["inode"].as_u64(), Some(metadata.ino()));
+        let digest = Sha256::digest(fs::read(&backup).expect("retained member bytes"));
+        assert_eq!(witness["sha256"], beads_rust::util::hex_encode(&digest));
+        expected_names.insert(name);
+    }
+    for suffix in receipt["family_suffixes"]
+        .as_array()
+        .expect("sidecar catalog")
+    {
+        let suffix = suffix.as_str().expect("catalog suffix");
+        assert_eq!(
+            recovery_dir
+                .join(format!("beads.db{suffix}.{stamp}.bak"))
+                .exists(),
+            suffixes.contains(suffix),
+            "recorded sidecar absences must match the retained family"
+        );
+    }
+    let generation = format!(".{stamp}.");
+    let actual_names: BTreeSet<_> = fs::read_dir(&recovery_dir)
+        .expect("recovery inventory")
+        .map(|entry| {
+            entry
+                .expect("recovery entry")
+                .file_name()
+                .into_string()
+                .expect("fixture filename")
+        })
+        .filter(|name| name.starts_with("beads.db") && name.contains(&generation))
+        .collect();
+    assert_eq!(actual_names, expected_names, "complete retained generation");
+}
