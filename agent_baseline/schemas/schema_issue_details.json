{
  "tool": "br",
  "generated_at": "<GENERATED_AT>",
  "schemas": {
    "IssueDetails": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "IssueDetails",
      "description": "Issue details with full relations for show view.",
      "type": "object",
      "properties": {
        "id": {
          "description": "Unique ID (e.g., \"bd-abc123\").",
          "type": "string"
        },
        "title": {
          "description": "Title (1-500 chars).",
          "type": "string"
        },
        "description": {
          "description": "Detailed description.",
          "type": [
            "string",
            "null"
          ]
        },
        "design": {
          "description": "Technical design notes.",
          "type": [
            "string",
            "null"
          ]
        },
        "acceptance_criteria": {
          "description": "Acceptance criteria.",
          "type": [
            "string",
            "null"
          ]
        },
        "notes": {
          "description": "Additional notes.",
          "type": [
            "string",
            "null"
          ]
        },
        "status": {
          "description": "Workflow status.",
          "$ref": "#/$defs/Status",
          "default": "open"
        },
        "priority": {
          "description": "Priority (0=Critical, 4=Backlog).",
          "$ref": "#/$defs/Priority",
          "default": 2
        },
        "issue_type": {
          "description": "Issue type (bug, feature, etc.).",
          "$ref": "#/$defs/IssueType",
          "default": "task"
        },
        "assignee": {
          "description": "Assigned user.",
          "type": [
            "string",
            "null"
          ]
        },
        "owner": {
          "description": "Issue owner.",
          "type": [
            "string",
            "null"
          ]
        },
        "estimated_minutes": {
          "description": "Estimated effort in minutes.",
          "type": [
            "integer",
            "null"
          ],
          "format": "int32"
        },
        "created_at": {
          "description": "Creation timestamp.",
          "type": "string",
          "format": "date-time"
        },
        "created_by": {
          "description": "Creator username.",
          "type": [
            "string",
            "null"
          ]
        },
        "updated_at": {
          "description": "Last update timestamp.",
          "type": "string",
          "format": "date-time"
        },
        "closed_at": {
          "description": "Closure timestamp.",
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "close_reason": {
          "description": "Reason for closure.",
          "type": [
            "string",
            "null"
          ]
        },
        "closed_by_session": {
          "description": "Session ID that closed this issue.",
          "type": [
            "string",
            "null"
          ]
        },
        "bypassed_policy": {
          "description": "Close-policy bypass audit trail (GitHub #474). Serialized into the\nJSONL export only when the close bypassed policy so a bypassed close\nis reviewable off-machine; absent means \"not bypassed\" (pre-change\nexports stay valid). Backed by the DB-only `close_metadata` table;\nexcluded from `content_hash` and from `sync_equals`.",
          "type": [
            "boolean",
            "null"
          ]
        },
        "bypass_reason": {
          "description": "Operator-supplied reason for the policy bypass (GitHub #474).",
          "type": [
            "string",
            "null"
          ]
        },
        "policy_gates_fired": {
          "description": "Names of the close-policy gates the bypass overrode (GitHub #474).",
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          }
        },
        "due_at": {
          "description": "Due date.",
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "defer_until": {
          "description": "Defer until date.",
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "external_ref": {
          "description": "External reference (e.g., JIRA-123).",
          "type": [
            "string",
            "null"
          ]
        },
        "source_system": {
          "description": "Source system for imported issues.",
          "type": [
            "string",
            "null"
          ]
        },
        "source_repo": {
          "description": "Source repository for multi-repo support — basename of the\ncanonicalized parent of `.beads/`. Stable across clones of the\nsame repo on different machines (different absolute paths\nproduce the same basename). See [`canonical_source_repo`] in\n`cli::commands::create`.",
          "type": [
            "string",
            "null"
          ]
        },
        "source_repo_path": {
          "description": "Absolute canonical path of the source repository. Distinct from\n`source_repo`: this field uniquely identifies the workspace on\nthe machine that produced the issue, which is what multi-repo\nfleet automation needs to route beads back to the right\ndirectory (see beads_rust#289). Two clones of the same repo\nunder `~/Developer/foo` vs `~/Developer/scratch/foo` collide on\n`source_repo` but disagree here. Optional — older databases and\nhand-edited JSONL records without this field are valid.",
          "type": [
            "string",
            "null"
          ]
        },
        "agent_context": {
          "description": "Canonical-JSON governing instructions inherited by descendant\nbeads (beads_rust#297). When set on an ancestor and the project\nhas `inherited_context.enabled = true` in `.beads/config.yaml`,\n`br update --status in_progress` / `--claim` and `br show` emit\nthe ancestor's `agent_context` alongside the child's normal\noutput so the working agent sees the constraints regardless of\ncontext compaction or cold-start lookups.\n\nStorage: TEXT column holding a JSON document (typically an\nobject with `skills`, `constraints`, `references`, `workflow`,\n`metadata` fields, but the schema is intentionally open).\n`None` means \"no inherited context\"; emission for descendants\nsilently skips ancestors with `None` (no error, no noise).\n\nNot displayed in `br list` / `br search` — this is per-bead\ngovernance metadata, not browsable content.",
          "type": [
            "string",
            "null"
          ]
        },
        "deleted_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "deleted_by": {
          "type": [
            "string",
            "null"
          ]
        },
        "delete_reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "original_type": {
          "type": [
            "string",
            "null"
          ]
        },
        "compaction_level": {
          "type": [
            "integer",
            "null"
          ],
          "format": "int32",
          "default": 0
        },
        "compacted_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "compacted_at_commit": {
          "type": [
            "string",
            "null"
          ]
        },
        "original_size": {
          "type": [
            "integer",
            "null"
          ],
          "format": "int32"
        },
        "sender": {
          "type": [
            "string",
            "null"
          ]
        },
        "ephemeral": {
          "type": "boolean"
        },
        "pinned": {
          "type": "boolean"
        },
        "is_template": {
          "type": "boolean"
        },
        "labels": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "dependencies": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/IssueWithDependencyMetadata"
          }
        },
        "comments": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Comment"
          }
        },
        "dependents": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/IssueWithDependencyMetadata"
          }
        },
        "events": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Event"
          }
        },
        "parent": {
          "type": [
            "string",
            "null"
          ]
        },
        "rollup": {
          "description": "Derived parent-child subtree rollup; present only when the issue has\nlocal parent-child children (GitHub #384 phase 3).",
          "anyOf": [
            {
              "$ref": "#/$defs/RollupSummary"
            },
            {
              "type": "null"
            }
          ]
        },
        "acceptance_items": {
          "description": "The `acceptance_criteria` checklist as structured items (1-based\n`index`, `text`, `checked`), the same parse `br update\n--check-acceptance` edits by; empty when the field has no checklist\n(GitHub #477).",
          "type": "array",
          "items": {
            "$ref": "#/$defs/AcceptanceItem"
          }
        },
        "inherited_context": {
          "description": "Inherited governing context from ancestor beads (beads_rust#297).\nPresent only when the project has opted in to inherited-context\nemission and an ancestor supplies `agent_context`; populated for\nJSON/TOON output so structured consumers receive the same governing\ncontext that text mode renders (beads_rust#430).",
          "type": "array",
          "items": {
            "$ref": "#/$defs/InheritedBlock"
          }
        }
      },
      "required": [
        "id",
        "title",
        "status",
        "priority",
        "issue_type",
        "created_at",
        "updated_at",
        "compaction_level"
      ],
      "$defs": {
        "Status": {
          "description": "Issue lifecycle status.",
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "open",
                "in_progress",
                "blocked",
                "deferred",
                "draft",
                "closed",
                "tombstone",
                "pinned"
              ]
            },
            {
              "type": "string"
            }
          ]
        },
        "Priority": {
          "description": "Issue priority (0=Critical, 4=Backlog).",
          "type": "integer",
          "format": "int32"
        },
        "IssueType": {
          "description": "Issue type category.",
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "task",
                "bug",
                "feature",
                "epic",
                "chore",
                "docs",
                "question"
              ]
            },
            {
              "type": "string"
            }
          ]
        },
        "Dependency": {
          "description": "Relationship between two issues.",
          "type": "object",
          "properties": {
            "issue_id": {
              "description": "The issue that has the dependency (source).",
              "type": "string"
            },
            "depends_on_id": {
              "description": "The issue being depended on (target).",
              "type": "string"
            },
            "type": {
              "description": "Type of dependency.",
              "$ref": "#/$defs/DependencyType"
            },
            "created_at": {
              "description": "Creation timestamp.",
              "type": "string",
              "format": "date-time"
            },
            "created_by": {
              "description": "Creator.",
              "type": [
                "string",
                "null"
              ]
            },
            "metadata": {
              "description": "Optional metadata (JSON).\n\nA degenerate empty (or whitespace-only) string is coerced to `None` on\ndeserialization to tolerate legacy JSONL that wrote `\"metadata\":\"\"`\ninstead of omitting the field. See [`deserialize_optional_metadata`].",
              "type": [
                "string",
                "null"
              ]
            },
            "thread_id": {
              "description": "Thread ID for conversation linking.",
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "issue_id",
            "depends_on_id",
            "type",
            "created_at"
          ]
        },
        "DependencyType": {
          "description": "Dependency relationship type.",
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "blocks",
                "parent-child",
                "conditional-blocks",
                "waits-for",
                "related",
                "discovered-from",
                "replies-to",
                "relates-to",
                "duplicates",
                "supersedes",
                "caused-by"
              ]
            },
            {
              "type": "string"
            }
          ]
        },
        "Comment": {
          "description": "A comment on an issue.",
          "type": "object",
          "properties": {
            "id": {
              "description": "Database-local rowid. It is exported to JSONL for reference only:\nevery clone mints its own sequence, so two clones' comments routinely\nshare an id and import reassigns the local rowid when that happens.\nSync compares comments by [`Comment::sync_key`], never by `id`.",
              "type": "integer",
              "format": "int64"
            },
            "issue_id": {
              "type": "string"
            },
            "author": {
              "type": "string"
            },
            "text": {
              "type": "string"
            },
            "created_at": {
              "type": "string",
              "format": "date-time"
            }
          },
          "required": [
            "id",
            "issue_id",
            "author",
            "text",
            "created_at"
          ]
        },
        "IssueWithDependencyMetadata": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string"
            },
            "title": {
              "type": "string"
            },
            "status": {
              "$ref": "#/$defs/Status"
            },
            "priority": {
              "$ref": "#/$defs/Priority"
            },
            "dependency_type": {
              "type": "string"
            }
          },
          "required": [
            "id",
            "title",
            "status",
            "priority",
            "dependency_type"
          ]
        },
        "Event": {
          "description": "An event in the issue's history (audit log).",
          "type": "object",
          "properties": {
            "id": {
              "type": "integer",
              "format": "int64"
            },
            "issue_id": {
              "type": "string"
            },
            "event_type": {
              "$ref": "#/$defs/EventType"
            },
            "actor": {
              "type": "string"
            },
            "old_value": {
              "type": [
                "string",
                "null"
              ]
            },
            "new_value": {
              "type": [
                "string",
                "null"
              ]
            },
            "comment": {
              "type": [
                "string",
                "null"
              ]
            },
            "created_at": {
              "type": "string",
              "format": "date-time"
            },
            "agent_name": {
              "description": "Tier 1 attribution: self-reported agent name (issue #312, Layer 3\ncapture-only). Recorded as an audit trail; never gated/enforced on.\n`None` when the mutating command supplied no attribution.",
              "type": [
                "string",
                "null"
              ]
            },
            "harness": {
              "description": "Tier 1 attribution: self-reported harness identifier (capture-only).",
              "type": [
                "string",
                "null"
              ]
            },
            "model": {
              "description": "Tier 1 attribution: self-reported model identifier (capture-only).",
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "id",
            "issue_id",
            "event_type",
            "actor",
            "created_at"
          ]
        },
        "EventType": {
          "type": "string"
        },
        "RollupSummary": {
          "description": "Derived parent-child subtree rollup for a parent issue (GitHub #384\nphase 3: hierarchy observability).\n\nThe rollup reports what a parent's subtree is effectively doing without\nmutating the parent's explicit status: an epic can stay `open` while its\nrollup says `in_progress` because a descendant started.",
          "type": "object",
          "properties": {
            "status": {
              "description": "Furthest-along non-terminal descendant status in workflow order, or\n`closed` when every descendant is terminal.",
              "type": "string"
            },
            "descendants": {
              "description": "Count of strict parent-child descendants by stored status.",
              "type": "object",
              "additionalProperties": {
                "type": "integer",
                "format": "uint32",
                "minimum": 0
              }
            }
          },
          "required": [
            "status",
            "descendants"
          ]
        },
        "AcceptanceItem": {
          "description": "One checklist item of an acceptance-criteria field.",
          "type": "object",
          "properties": {
            "index": {
              "description": "One-based position among the checklist items.",
              "type": "integer",
              "format": "uint",
              "minimum": 0
            },
            "text": {
              "description": "Item text without the bullet and checkbox.",
              "type": "string"
            },
            "checked": {
              "description": "Whether the box is ticked.",
              "type": "boolean"
            }
          },
          "required": [
            "index",
            "text",
            "checked"
          ]
        },
        "InheritedBlock": {
          "description": "One ancestor block in the inherited-context emission.",
          "type": "object",
          "properties": {
            "source_id": {
              "description": "The ancestor's bead id (e.g. \"bd-abc123\").",
              "type": "string"
            },
            "source_role": {
              "description": "\"epic\" when the ancestor is the root and has `issue_type = epic`,\n\"root\" when the ancestor is the root but not an epic,\n\"parent\" when the ancestor is the immediate parent.",
              "type": "string"
            },
            "source_title": {
              "description": "The ancestor's title for human-readable headings.",
              "type": "string"
            },
            "field_used": {
              "description": "Which field on the ancestor supplied the content (e.g.\n\"agent_context\"). Per-config-field-list resolution: in a future\nextension callers can configure `[agent_context, design]` and\nthe first present wins.",
              "type": "string"
            },
            "content": {
              "description": "The raw content, as stored. For `agent_context` this is the\ncanonical JSON string; downstream renderers can parse it for\npretty-printing.",
              "type": "string"
            }
          },
          "required": [
            "source_id",
            "source_role",
            "source_title",
            "field_used",
            "content"
          ]
        }
      }
    }
  }
}
