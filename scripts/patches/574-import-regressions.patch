+#[cfg(test)]
+mod import_sql_regression_tests {
+    use super::*;
+    use crate::franken_sync::sql_capture;
+    use std::io::Write as _;
+    use std::sync::{Arc, Mutex};
+
+    #[derive(Clone, Default)]
+    struct WarningBuffer(Arc<Mutex<Vec<u8>>>);
+
+    impl std::io::Write for WarningBuffer {
+        fn write(&mut self, bytes: &[u8]) -> std::io::Result<usize> {
+            self.0.lock().unwrap().extend_from_slice(bytes);
+            Ok(bytes.len())
+        }
+
+        fn flush(&mut self) -> std::io::Result<()> {
+            Ok(())
+        }
+    }
+
+    fn write_rows(path: &Path, issues: &[Issue]) {
+        let mut file = File::create(path).unwrap();
+        for issue in issues {
+            serde_json::to_writer(&mut file, issue).unwrap();
+            writeln!(&mut file).unwrap();
+        }
+    }
+
+    // The reporter's topology: N blocked issues, each with two unique open
+    // blockers; all 3N rows carry a label. Initial import is outside capture.
+    fn fixture(blocked_count: usize) -> (tempfile::TempDir, PathBuf, SqliteStorage, Vec<Issue>) {
+        let temp = tempfile::TempDir::new().unwrap();
+        let path = temp.path().join("issues.jsonl");
+        let stamp = "2026-10-01T00:00:00Z";
+        let issue = |id: String, dependencies: Vec<String>| -> Issue {
+            serde_json::from_value(serde_json::json!({
+                "id": id,
+                "title": format!("Fixture {id}"),
+                "description": "seeded",
+                "status": "open",
+                "priority": 2,
+                "issue_type": "task",
+                "created_at": stamp,
+                "created_by": "seed",
+                "updated_at": stamp,
+                "source_repo": ".",
+                "compaction_level": 0,
+                "original_size": 0,
+                "labels": ["seed"],
+                "comments": [],
+                "dependencies": dependencies.iter().map(|target| serde_json::json!({
+                    "issue_id": id,
+                    "depends_on_id": target,
+                    "type": "blocks",
+                    "created_at": stamp,
+                    "created_by": "seed",
+                    "metadata": "{}",
+                    "thread_id": ""
+                })).collect::<Vec<_>>()
+            })).unwrap()
+        };
+        let mut rows = (0..2 * blocked_count)
+            .map(|index| issue(format!("nb-k{index:05}"), Vec::new()))
+            .collect::<Vec<_>>();
+        rows.extend((0..blocked_count).map(|index| {
+            issue(
+                format!("nb-b{index:05}"),
+                vec![format!("nb-k{:05}", 2 * index), format!("nb-k{:05}", 2 * index + 1)],
+            )
+        }));
+        rows.sort_by(|left, right| left.id.cmp(&right.id));
+        write_rows(&path, &rows);
+        let mut storage = SqliteStorage::open_memory().unwrap();
+        let imported = import_from_jsonl(
+            &mut storage, &path, &ImportConfig::default(), Some("nb"),
+        ).unwrap();
+        assert_eq!(imported.imported_count, rows.len());
+        let ids = rows.iter().map(|row| row.id.clone()).collect::<Vec<_>>();
+        let mut hydrated = storage.get_issues_for_import_comparison_live(&ids).unwrap();
+        hydrated.sort_by(|left, right| left.id.cmp(&right.id));
+        assert_eq!(hydrated.len(), rows.len());
+        (temp, path, storage, hydrated)
+    }
+
+    fn captured_import(storage: &mut SqliteStorage, path: &Path) -> (ImportResult, Vec<String>, String) {
+        let warnings = WarningBuffer::default();
+        let writer = warnings.clone();
+        let subscriber = tracing_subscriber::fmt()
+            .with_max_level(tracing::Level::WARN)
+            .with_ansi(false)
+            .with_writer(move || writer.clone())
+            .finish();
+        let (result, statements) = tracing::subscriber::with_default(subscriber, || {
+            sql_capture::capture(|| {
+                import_from_jsonl(storage, path, &ImportConfig::default(), Some("nb"))
+            })
+        });
+        let text = String::from_utf8(warnings.0.lock().unwrap().clone()).unwrap();
+        eprintln!(
+            "SQL574 total={} issue_point_reads={} export_hash_writes={} skip_warnings={}",
+            statements.len(),
+            statements.iter().filter(|sql| sql.contains("FROM issues WHERE id =")).count(),
+            hash_writes(&statements).len(),
+            text.matches("Import skip:").count(),
+        );
+        (result.unwrap(), statements, text)
+    }
+
+    fn hash_writes(statements: &[String]) -> Vec<&str> {
+        statements.iter().filter_map(|statement| {
+            let sql = statement.strip_prefix("PREPARE ").unwrap_or(statement);
+            ((sql.starts_with("INSERT") || sql.starts_with("DELETE") || sql.starts_with("UPDATE"))
+                && sql.contains("export_hashes"))
+                .then_some(sql)
+        }).collect()
+    }
+
+    #[test]
+    fn one_changed_import_does_not_read_or_rewrite_each_skipped_row() {
+        let (_temp, path, mut storage, mut rows) = fixture(500);
+        let untouched_id = rows.last().unwrap().id.clone();
+        let certificate_before = storage.get_export_hash(&untouched_id).unwrap();
+        assert!(certificate_before.is_some());
+        rows[0].title.push_str(" changed upstream");
+        rows[0].updated_at += chrono::Duration::days(1);
+        write_rows(&path, &rows);
+
+        let (result, statements, warnings) = captured_import(&mut storage, &path);
+        assert_eq!(result.created_count, 0);
+        assert_eq!(result.updated_count, 1);
+        assert_eq!(result.skipped_count, 1499);
+        assert_eq!(result.export_hashes_recorded, 1500);
+        let point_reads = statements.iter().filter(|sql| {
+            sql.contains("FROM issues WHERE id =")
+        }).count();
+        assert!(point_reads <= 16, "unexpected point-read growth: {point_reads}");
+        assert!(!warnings.contains("Import skip:"), "{warnings}");
+        let writes = hash_writes(&statements);
+        assert_eq!(writes.len(), 2, "only the changed certificate is replaced: {writes:?}");
+        assert!(!writes.iter().any(|sql| *sql == "DELETE FROM export_hashes"));
+        assert_eq!(storage.get_export_hash(&untouched_id).unwrap(), certificate_before);
+
+        let ids = rows.iter().map(|row| row.id.clone()).collect::<Vec<_>>();
+        let mut actual = storage.get_issues_for_import_comparison_live(&ids).unwrap();
+        actual.sort_by(|left, right| left.id.cmp(&right.id));
+        assert_eq!(actual.len(), rows.len());
+        for (stored, expected) in actual.iter().zip(&rows) {
+            assert!(skipped_import_matches_stored_issue(Some(stored), &expected.id, expected));
+        }
+
+        // Reimport the actual exported payload, not the stale input hashes.
+        write_rows(&path, &actual);
+        let (result, statements, warnings) = captured_import(&mut storage, &path);
+        assert_eq!(result.updated_count, 0);
+        assert_eq!(result.skipped_count, 1500);
+        assert!(hash_writes(&statements).is_empty());
+        assert!(!warnings.contains("Import skip:"), "{warnings}");
+    }
+
+    #[test]
+    fn timestamp_only_import_keeps_its_existing_certificate() {
+        let (_temp, path, mut storage, mut rows) = fixture(2);
+        let target = rows[0].id.clone();
+        let before = storage.get_export_hash(&target).unwrap();
+        assert!(before.is_some());
+        rows[0].updated_at += chrono::Duration::days(1);
+        write_rows(&path, &rows);
+        let (result, _, warnings) = captured_import(&mut storage, &path);
+        assert_eq!(result.created_count, 0);
+        assert_eq!(result.export_hashes_recorded, rows.len());
+        assert_eq!(storage.get_export_hash(&target).unwrap(), before);
+        assert!(!warnings.contains("Import skip:"), "{warnings}");
+        let stored = storage.get_issues_for_import_comparison_live(&[target.clone()]).unwrap();
+        assert_eq!(stored.len(), 1);
+        assert!(skipped_import_matches_stored_issue(Some(&stored[0]), &target, &rows[0]));
+    }
+
+    #[test]
+    fn full_replacement_retains_the_insert_only_hash_path() {
+        let (_temp, path, mut storage, mut rows) = fixture(2);
+        for row in &mut rows {
+            row.title.push_str(" replaced");
+            row.updated_at += chrono::Duration::days(1);
+        }
+        write_rows(&path, &rows);
+        let (result, statements, warnings) = captured_import(&mut storage, &path);
