+    #[test]
+    fn automatic_conflict_rolls_back_earlier_rows_and_certificates() {
+        let (_temp, path, mut storage, mut rows) = fixture(2);
+        let original_first = rows[0].title.clone();
+        storage.update_issue(
+            &rows[1].id,
+            &crate::storage::IssueUpdate { title: Some("newer local winner".to_string()), ..Default::default() },
+            "tester",
+        ).unwrap();
+        let hashes_before = storage.execute_raw_query(
+            "SELECT issue_id, content_hash, exported_at FROM export_hashes ORDER BY issue_id",
+        ).unwrap();
+        rows[0].title.push_str(" must roll back");
+        rows[0].updated_at += chrono::Duration::days(1);
+        write_rows(&path, &rows);
+        let source = capture_jsonl_source_snapshot(&path).unwrap();
+        let error = import_from_jsonl_snapshot_impl(
+            &mut storage, &source, &ImportConfig::default(), Some("nb"), ImportMode::Automatic, None,
+        ).unwrap_err();
+        assert!(matches!(error, BeadsError::SyncConflict { .. }), "{error}");
+        assert_eq!(storage.get_issue(&rows[0].id).unwrap().unwrap().title, original_first);
+        assert_eq!(storage.execute_raw_query(
+            "SELECT issue_id, content_hash, exported_at FROM export_hashes ORDER BY issue_id",
+        ).unwrap(), hashes_before);
+    }
