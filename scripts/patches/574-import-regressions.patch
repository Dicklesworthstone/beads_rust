+/// Test-only SQL facade observations. Collection is scoped to one thread and
+/// restored on unwind; production builds contain neither the slot nor hooks.
+/// Counts follow #574: direct facade calls and prepares, not engine retries,
+/// VM steps, or executions through an already-prepared statement.
+#[cfg(test)]
+pub(crate) mod sql_capture {
+    use std::cell::RefCell;
+
+    thread_local! {
+        static STATEMENTS: RefCell<Option<Vec<String>>> = const { RefCell::new(None) };
+    }
+
+    pub(super) fn record(sql: &str, prepared: bool) {
+        STATEMENTS.with(|slot| {
+            if let Some(statements) = slot.borrow_mut().as_mut() {
+                let normalized = sql.split_whitespace().collect::<Vec<_>>().join(" ");
+                statements.push(if prepared {
+                    format!("PREPARE {normalized}")
+                } else {
+                    normalized
+                });
+            }
+        });
+    }
+
+    /// Observe only `operation`; fixture setup and assertions stay outside.
+    /// Nested captures observe their own statements, not their parent's.
+    pub(crate) fn capture<T>(operation: impl FnOnce() -> T) -> (T, Vec<String>) {
+        struct Restore(Option<Vec<String>>);
+        impl Drop for Restore {
+            fn drop(&mut self) {
+                STATEMENTS.with(|slot| {
+                    *slot.borrow_mut() = self.0.take();
+                });
+            }
+        }
+
+        let _restore = Restore(STATEMENTS.with(|slot| slot.replace(Some(Vec::new()))));
+        let result = operation();
+        let statements = STATEMENTS.with(|slot| slot.borrow_mut().take().unwrap_or_default());
+        (result, statements)
+    }
+
+    #[test]
+    fn capture_restores_nested_and_panicking_scopes() {
+        let (_, outer) = capture(|| {
+            record("SELECT 1", false);
+            let (_, inner) = capture(|| record("SELECT 2", true));
+            assert_eq!(inner, vec!["PREPARE SELECT 2"]);
+            assert!(std::panic::catch_unwind(|| {
+                capture(|| {
+                    record("SELECT 3", false);
+                    panic!("exercise capture unwind");
+                });
+            }).is_err());
+            record("SELECT 4", false);
+        });
+        assert_eq!(outer, vec!["SELECT 1", "SELECT 4"]);
+        let (_, next) = capture(|| record("SELECT 5", false));
+        assert_eq!(next, vec!["SELECT 5"]);
+    }
+}
