# Maintainer: Jeffrey Emanuel <jeff141421@gmail.com>
# br-bin - Pre-built binary package for br (agent-first issue tracker)
#
# To build: makepkg -si
# Local recipe: br-bin is not registered on AUR as of 2026-09-12.
# The separately maintained beads-rust-bin package is not this recipe.

pkgname=br-bin
pkgver=0.7.3
pkgrel=1
pkgdesc="Agent-first issue tracker (SQLite + JSONL)"
arch=('x86_64' 'aarch64')
url="https://github.com/Dicklesworthstone/beads_rust"
license=('LicenseRef-MIT-OpenAI-Anthropic-Rider')
provides=('br')
conflicts=('br' 'br-git')
depends=('gcc-libs')
# Preserve the verified release executable, which is already stripped.
options=('!strip' '!debug')

source_x86_64=("${pkgname}-${pkgver}-x86_64.tar.gz::https://github.com/Dicklesworthstone/beads_rust/releases/download/v${pkgver}/br-${pkgver}-linux_amd64.tar.gz")
source_aarch64=("${pkgname}-${pkgver}-aarch64.tar.gz::https://github.com/Dicklesworthstone/beads_rust/releases/download/v${pkgver}/br-${pkgver}-linux_arm64.tar.gz")

sha256sums_x86_64=('4fcb20b8352eb85359b0f9ff7ec31f6c057ecf8e26184252c36ab1e447eef986')
sha256sums_aarch64=('025d61e8d05426ed37d3b1045f893a92a587c6ba90ce24989232b4c0a38fcb8c')

package() {
    install -Dm755 "${srcdir}/br" "${pkgdir}/usr/bin/br"

    # v0.4.1 predates bundled licenses; v0.5.1 and later archives include it.
    if [[ -f "${srcdir}/LICENSE" ]]; then
        install -Dm644 "${srcdir}/LICENSE" "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
    fi
}
