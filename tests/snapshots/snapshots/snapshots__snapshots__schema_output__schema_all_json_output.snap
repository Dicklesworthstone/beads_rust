t the schema is intentionally open).\n`None` means \"no inherited context\"; emission for descendants\nsilently skips ancestors with `None` (no error, no noise).\n\nNot displayed in `br list` / `br search` — this is per-bead\ngovernance metadata, not browsable content.","type":["string","null"]},"deleted_at":{"type":["string","null"],"format":"date-time"},"deleted_by":{"type":["string","null"]},"delete_reason":{"type":["string","null"]},"original_type":{"type":["string","null"]},"compaction_level":{"type":["integer","null"],"format":"int32","default":0},"compacted_at":{"type":["string","null"],"format":"date-time"},"compacted_at_commit":{"type":["string","null"]},"original_size":{"type":["integer","null"],"format":"int32"},"sender":{"type":["string","null"]},"ephemeral":{"type":"boolean"},"pinned":{"type":"boolean"},"is_template":{"type":"boolean"},"labels":{"type":"array","items":{"type":"string"}},"dependencies":{"type":"array","items":{"$ref":"#/$defs/IssueWithDependencyMetadata"}},"comments":{"type":"array","items":{"$ref":"#/$defs/Comment"}},"dependents":{"type":"array","items":{"$ref":"#/$defs/IssueWithDependencyMetadata"}},"events":{"type":"array","items":{"$ref":"#/$defs/Event"}},"parent":{"type":["string","null"]},"rollup":{"description":"Derived parent-child subtree rollup; present only when the issue has\nlocal parent-child children (GitHub #384 phase 3).","anyOf":[{"$ref":"#/$defs/RollupSummary"},{"type":"null"}]},"inherited_context":{"description":"Inherited governing context from ancestor beads (beads_rust#297).\nPresent only when the project has opted in to inherited-context\nemission and an ancestor supplies `agent_context`; populated for\nJSON/TOON output so structured consumers receive the same governing\ncontext that text mode renders (beads_rust#430).","type":"array","items":{"$ref":"#/$defs/InheritedBlock"}}},"required":["id","title","status","priority","issue_type","created_at","updated_at","compaction_level"],"$defs":{"Status":{"description":"Issue lifecycle status.","anyOf":[{"type":"string","enum":["open","in_progress","blocked","deferred","draft","closed","tombstone","pinned"]},{"type":"string"}]},"Priority":{"description":"Issue priority (0=Critical, 4=Backlog).","type":"integer","format":"int32"},"IssueType":{"description":"Issue type category.","anyOf":[{"type":"string","enum":["task","bug","feature","epic","chore","docs","question"]},{"type":"string"}]},"Dependency":{"description":"Relationship between two issues.","type":"object","properties":{"issue_id":{"description":"The issue that has the dependency (source).","type":"string"},"depends_on_id":{"description":"The issue being depended on (target).","type":"string"},"type":{"description":"Type of dependency.","$ref":"#/$defs/DependencyType"},"created_at":{"description":"Creation timestamp.","type":"string","format":"date-time"},"created_by":{"description":"Creator.","type":["string","null"]},"metadata":{"description":"Optional metadata (JSON).\n\nA degenerate empty (or whitespace-only) string is coerced to `None` on\ndeserialization to tolerate legacy JSONL that wrote `\"metadata\":\"\"`\ninstead of omitting the field. See [`deserialize_optional_metadata`].","type":["string","null"]},"thread_id":{"description":"Thread ID for conversation linking.","type":["string","null"]}},"required":["issue_id","depends_on_id","type","created_at"]},"DependencyType":{"description":"Dependency relationship type.","anyOf":[{"type":"string","enum":["blocks","parent-child","conditional-blocks","waits-for","related","discovered-from","replies-to","relates-to","duplicates","supersedes","caused-by"]},{"type":"string"}]},"Comment":{"description":"A comment on an issue.","type":"object","properties":{"id":{"type":"integer","format":"int64"},"issue_id":{"type":"string"},"author":{"type":"string"},"text":{"type":"string"},"created_at":{"type":"string","format":"date-time"}},"required":["id","issue_id","author","text","created_at"]},"IssueWithDependencyMetadata":{"type":"object","properties":{"id":{"type":"string"},"title":{"type":"string"},"status":{"$ref":"#/$defs/Status"},"priority":{"$ref":"#/$defs/Priority"},"dependency_type":{"type":"string"}},"required":["id","title","status","priority","dependency_type"]},"Event":{"description":"An event in the issue's history (audit log).","type":"object","properties":{"id":{"type":"integer","format":"int64"},"issue_id":{"type":"string"},"event_type":{"$ref":"#/$defs/EventType"},"actor":{"type":"string"},"old_value":{"type":["string","null"]},"new_value":{"type":["string","null"]},"comment":{"type":["string","null"]},"created_at":{"type":"string","format":"date-time"},"agent_name":{"description":"Tier 1 attribution: self-reported agent name (issue #312, Layer 3\ncapture-only). Recorded as an audit trail; never gated/enforced on.\n`None` when the mutating command supplied no attribution.","type":["string","null"]},"harness":{"description":"Tier 1 attribution: self-reported harness identifier (capture-only).","type":["string","null"]},"model":{"description":"Tier 1 attribution: self-reported model identifier (capture-only).","type":["string","null"]}},"required":["id","issue_id","event_type","actor","created_at"]},"EventType":{"type":"string"},"RollupSummary":{"description":"Derived parent-child subtree rollup for a parent issue (GitHub #384\nphase 3: hierarchy observability).\n\nThe rollup reports what a parent's subtree is effectively doing without\nmutating the parent's explicit status: an epic can stay `open` while its\nrollup says `in_progress` because a descendant started.","type":"object","properties":{"status":{"description":"Furthest-along non-terminal descendant status in workflow order, or\n`closed` when every descendant is terminal.","type":"string"},"descendants":{"description":"Count of strict parent-child descendants by stored status.","type":"object","additionalProperties":{"type":"integer","format":"uint32","minimum":0}}},"required":["status","descendants"]},"InheritedBlock":{"description":"One ancestor block in the inherited-context emission.","type":"object","properties":{"source_id":{"description":"The ancestor's bead id (e.g. \"bd-abc123\").","type":"string"},"source_role":{"description":"\"epic\" when the ancestor is the root and has `issue_type = epic`,\n\"root\" when the ancestor is the root but not an epic,\n\"parent\" when the ancestor is the immediate parent.","type":"string"},"source_title":{"description":"The ancestor's title for human-readable headings.","type":"string"},"field_used":{"description":"Which field on the ancestor supplied the content (e.g.\n\"agent_context\"). Per-config-field-list resolution: in a future\nextension callers can configure `[agent_context, design]` and\nthe first present wins.","type":"string"},"content":{"description":"The raw content, as stored. For `agent_context` this is the\ncanonical JSON string; downstream renderers can parse it for\npretty-printing.","type":"string"}},"required":["source_id","source_role","source_title","field_used","content"]}}},"IssueWithCounts":{"$schema":"https://json-schema.org/draft/2020-12/schema","title":"IssueWithCounts","description":"Issue with counts for list/search views.","type":"object","properties":{"id":{"description":"Unique ID (e.g., \"bd-abc123\").","type":"string"},"title":{"description":"Title (1-500 chars).","type":"string"},"description":{"description":"Detailed description.","type":["string","null"]},"design":{"description":"Technical design notes.","type":["string","null"]},"acceptance_criteria":{"description":"Acceptance criteria.","type":["string","null"]},"notes":{"description":"Additional notes.","type":["string","null"]},"status":{"description":"Workflow status.","$ref":"#/$defs/Status","default":"open"},"priority":{"description":"Priority (0=Critical, 4=Backlog).","$ref":"#/$defs/Priority","default":2},"issue_type":{"description":"Issue type (bug, feature, etc.).","$ref":"#/$defs/IssueType","default":"task"},"assignee":{"description":"Assigned user.","type":["string","null"]},"owner":{"description":"Issue owner.","type":["string","null"]},"estimated_minutes":{"description":"Estimated effort in minutes.","type":["integer","null"],"format":"int32"},"created_at":{"description":"Creation timestamp.","type":"string","format":"date-time"},"created_by":{"description":"Creator username.","type":["string","null"]},"updated_at":{"description":"Last update timestamp.","type":"string","format":"date-time"},"closed_at":{"description":"Closure timestamp.","type":["string","null"],"format":"date-time"},"close_reason":{"description":"Reason for closure.","type":["string","null"]},"closed_by_session":{"description":"Session ID that closed this issue.","type":["string","null"]},"due_at":{"description":"Due date.","type":["string","null"],"format":"date-time"},"defer_until":{"description":"Defer until date.","type":["string","null"],"format":"date-time"},"external_ref":{"description":"External reference (e.g., JIRA-123).","type":["string","null"]},"source_system":{"description":"Source system for imported issues.","type":["string","null"]},"source_repo":{"description":"Source repository for multi-repo support — basename of the\ncanonicalized parent of `.beads/`. Stable across clones of the\nsame repo on different machines (different absolute paths\nproduce the same basename). See [`canonical_source_repo`] in\n`cli::commands::create`.","type":["string","null"]},"source_repo_path":{"description":"Absolute canonical path of the source repository. Distinct from\n`source_repo`: this field uniquely identifies the workspace on\nthe machine that produced the issue, which is what multi-repo\nfleet automation needs to route beads back to the right\ndirectory (see beads_rust#289). Two clones of the same repo\nunder `~/Developer/foo` vs `~/Developer/scratch/foo` collide on\n`source_repo` but disagree here. Optional — older databases and\nhand-edited JSONL records without this field are valid.","type":["string","null"]},"agent_context":{"description":"Canonical-JSON governing instructions inherited by descendant\nbeads (beads_rust#297). When set on an ancestor and the project\nhas `inherited_context.enabled = true` in `.beads/config.yaml`,\n`br update --status in_progress` / `--claim` and `br show` emit\nthe ancestor's `agent_context` alongside the child's normal\noutput so the working agent sees the constraints regardless of\ncontext compaction or cold-start lookups.\n\nStorage: TEXT column holding a JSON document (typically an\nobject with `skills`, `constraints`, `references`, `workflow`,\n`metadata` fields, but the schema is intentionally open).\n`None` means \"no inherited context\"; emission for descendants\nsilently skips ancestors with `None` (no error, no noise).\n\nNot displayed in `br list` / `br search` — this is per-bead\ngovernance metadata, not browsable content.","type":["string","null"]},"deleted_at":{"type":["string","null"],"format":"date-time"},"deleted_by":{"type":["string","null"]},"delete_reason":{"type":["string","null"]},"original_type":{"type":["string","null"]},"compaction_level":{"type":["integer","null"],"format":"int32","default":0},"compacted_at":{"type":["string","null"],"format":"date-time"},"compacted_at_commit":{"type":["string","null"]},"original_size":{"type":["integer","null"],"format":"int32"},"sender":{"type":["string","null"]},"ephemeral":{"type":"boolean"},"pinned":{"type":"boolean"},"is_template":{"type":"boolean"},"labels":{"type":"array","items":{"type":"string"}},"dependencies":{"type":"array","items":{"$ref":"#/$defs/Dependency"}},"comments":{"type":"array","items":{"$ref":"#/$defs/Comment"}},"dependency_count":{"type":"integer","format":"uint","minimum":0},"dependent_count":{"type":"integer","format":"uint","minimum":0}},"required":["id","title","status","priority","issue_type","created_at","updated_at","compaction_level","dependency_count","dependent_count"],"$defs":{"Status":{"description":"Issue lifecycle status.","anyOf":[{"type":"string","enum":["open","in_progress","blocked","deferred","draft","closed","tombstone","pinned"]},{"type":"string"}]},"Priority":{"description":"Issue priority (0=Critical, 4=Backlog).","type":"integer","format":"int32"},"IssueType":{"description":"Issue type category.","anyOf":[{"type":"string","enum":["task","bug","feature","epic","chore","docs","question"]},{"type":"string"}]},"Dependency":{"description":"Relationship between two issues.","type":"object","properties":{"issue_id":{"description":"The issue that has the dependency (source).","type":"string"},"depends_on_id":{"description":"The issue being depended on (target).","type":"string"},"type":{"description":"Type of dependency.","$ref":"#/$defs/DependencyType"},"created_at":{"description":"Creation timestamp.","type":"string","format":"date-time"},"created_by":{"description":"Creator.","type":["string","null"]},"metadata":{"description":"Optional metadata (JSON).\n\nA degenerate empty (or whitespace-only) string is coerced to `None` on\ndeserialization to tolerate legacy JSONL that wrote `\"metadata\":\"\"`\ninstead of omitting the field. See [`deserialize_optional_metadata`].","type":["string","null"]},"thread_id":{"description":"Thread ID for conversation linking.","type":["string","null"]}},"required":["issue_id","depends_on_id","type","created_at"]},"DependencyType":{"description":"Dependency relationship type.","anyOf":[{"type":"string","enum":["blocks","parent-child","conditional-blocks","waits-for","related","discovered-from","replies-to","relates-to","duplicates","supersedes","caused-by"]},{"type":"string"}]},"Comment":{"description":"A comment on an issue.","type":"object","properties":{"id":{"type":"integer","format":"int64"},"issue_id":{"type":"string"},"author":{"type":"string"},"text":{"type":"string"},"created_at":{"type":"string","format":"date-time"}},"required":["id","issue_id","author","text","created_at"]}}},"ReadyIssue":{"$schema":"https://json-schema.org/draft/2020-12/schema","title":"ReadyIssue","description":"Minimal issue output for ready command (bd parity).\n\nContains only the fields that bd's ready command outputs.\nDoes NOT include: `compaction_level`, `original_size`, `dependency_count`, `dependent_count`","type":"object","properties":{"acceptance_criteria":{"type":["string","null"]},"assignee":{"type":["string","null"]},"created_at":{"type":"string","format":"date-time"},"created_by":{"type":["string","null"]},"description":{"type":["string","null"]},"estimated_minutes":{"type":["integer","null"],"format":"int32"},"id":{"type":"string"},"issue_type":{"$ref":"#/$defs/IssueType"},"labels":{"description":"Labels attached to the issue.\n\nAlways emitted (as `[]` when empty) so downstream consumers can filter\n`br ready --json` output on labels the same way they filter\n`br list --json` (#309).","type":"array","items":{"type":"string"}},"notes":{"type":["string","null"]},"owner":{"type":["string","null"]},"priority":{"$ref":"#/$defs/Priority"},"status":{"$ref":"#/$defs/Status"},"title":{"type":"string"},"updated_at":{"type":"string","format":"date-time"}},"required":["created_at","id","issue_type","labels","priority","status","title","updated_at"],"$defs":{"IssueType":{"description":"Issue type category.","anyOf":[{"type":"string","enum":["task","bug","feature","epic","chore","docs","question"]},{"type":"string"}]},"Priority":{"description":"Issue priority (0=Critical, 4=Backlog).","type":"integer","format":"int32"},"Status":{"description":"Issue lifecycle status.","anyOf":[{"type":"string","enum":["open","in_progress","blocked","deferred","draft","closed","tombstone","pinned"]},{"type":"string"}]}}},"StaleIssue":{"$schema":"https://json-schema.org/draft/2020-12/schema","title":"StaleIssue","description":"Minimal issue output for stale command (bd parity).\nContains only the fields that bd's stale command outputs.","type":"object","properties":{"created_at":{"type":"string","format":"date-time"},"id":{"type":"string"},"issue_type":{"$ref":"#/$defs/IssueType"},"priority":{"$ref":"#/$defs/Priority"},"status":{"$ref":"#/$defs/Status"},"title":{"type":"string"},"updated_at":{"type":"string","format":"date-time"},"assignee":{"type":["string","null"]}},"required":["created_at","id","issue_type","priority","status","title","updated_at"],"$defs":{"IssueType":{"description":"Issue type category.","anyOf":[{"type":"string","enum":["task","bug","feature","epic","chore","docs","question"]},{"type":"string"}]},"Priority":{"description":"Issue priority (0=Critical, 4=Backlog).","type":"integer","format":"int32"},"Status":{"description":"Issue lifecycle status.","anyOf":[{"type":"string","enum":["open","in_progress","blocked","deferred","draft","closed","tombstone","pinned"]},{"type":"string"}]}}},"Statistics":{"$schema":"https://json-schema.org/draft/2020-12/schema","title":"Statistics","description":"Aggregate statistics output.","type":"object","properties":{"summary":{"$ref":"#/$defs/StatsSummary"},"breakdowns":{"type":"array","items":{"$ref":"#/$defs/Breakdown"}},"recent_activity":{"anyOf":[{"$ref":"#/$defs/RecentActivity"},{"type":"null"}]},"capacity":{"description":"Workflow capacity occupancy (GitHub #384). Absent when no capacity\nis configured, preserving the pre-capacity payload shape.","type":"array","items":{"$ref":"#/$defs/CapacityStat"}}},"required":["summary"],"$defs":{"StatsSummary":{"description":"Summary statistics for the project.","type":"object","properties":{"total_issues":{"type":"integer","format":"uint","minimum":0},"open_issues":{"type":"integer","format":"uint","minimum":0},"in_progress_issues":{"type":"integer","format":"uint","minimum":0},"closed_issues":{"type":"integer","format":"uint","minimum":0},"blocked_issues":{"type":"integer","format":"uint","minimum":0},"deferred_issues":{"type":"integer","format":"uint","minimum":0},"draft_issues":{"type":"integer","format":"uint","minimum":0},"ready_issues":{"type":"integer","format":"uint","minimum":0},"tombstone_issues":{"type":"integer","format":"uint","minimum":0},"pinned_issues":{"type":"integer","format":"uint","minimum":0},"epics_eligible_for_closure":{"type":"integer","format":"uint","minimum":0},"average_lead_time_hours":{"type":["number","null"],"format":"double"}},"required":["total_issues","open_issues","in_progress_issues","closed_issues","blocked_issues","deferred_issues","draft_issues","ready_issues","tombstone_issues","pinned_issues","epics_eligible_for_closure"]},"Breakdown":{"description":"Breakdown statistics by a dimension.","type":"object","properties":{"dimension":{"type":"string"},"counts":{"type":"array","items":{"$ref":"#/$defs/BreakdownEntry"}}},"required":["dimension","counts"]},"BreakdownEntry":{"description":"A single entry in a breakdown.","type":"object","properties":{"key":{"type":"string"},"count":{"type":"integer","format":"uint","minimum":0}},"required":["key","count"]},"RecentActivity":{"description":"Recent activity statistics from git history.","type":"object","properties":{"hours_tracked":{"type":"integer","format":"uint32","minimum":0},"commit_count":{"type":"integer","format":"uint","minimum":0},"issues_created":{"type":"integer","format":"uint","minimum":0},"issues_closed":{"type":"integer","format":"uint","minimum":0},"issues_updated":{"type":"integer","format":"uint","minimum":0},"issues_reopened":{"type":"integer","format":"uint","minimum":0},"total_changes":{"type":"integer","format":"uint","minimum":0}},"required":["hours_tracked","commit_count","issues_created","issues_closed","issues_updated","issues_reopened","total_changes"]},"CapacityStat":{"description":"Observed occupancy of one workflow capacity (GitHub #384 phase 6).\n\nOne row per repository capacity plus one row per occupied partition of\neach scoped capacity, mirroring the enforcement engine's counting\n(exemptions and hierarchy modes included).","type":"object","properties":{"name":{"description":"The status or group name.","type":"string"},"kind":{"description":"`status` or `group`.","type":"string"},"scope":{"description":"Scope partition dimension (`repository`, `actor`, ...).","type":"string"},"scope_key":{"description":"Partition key within a non-repository scope.","type":["string","null"]},"counted":{"description":"Occupancy excluding exemptions (and hierarchy aggregates).","type":"integer","format":"uint32","minimum":0},"aggregate_parents_excluded":{"description":"Active issues excluded as hierarchy aggregates (`leaf_work`/`roots`).","type":["integer","null"],"format":"uint32","minimum":0},"exempt":{"description":"Occupancy excluded by active, authorized exemptions.","type":["integer","null"],"format":"uint32","minimum":0},"soft_limit":{"description":"Advisory threshold, if configured.","type":["integer","null"],"format":"uint32","minimum":0},"hard_limit":{"description":"Enforced threshold, if configured.","type":["integer","null"],"format":"uint32","minimum":0},"remaining":{"description":"`hard_limit - counted`, clamped at zero; absent without a hard limit.","type":["integer","null"],"format":"uint32","minimum":0},"state":{"description":"`healthy` | `soft-limit` | `at-hard` | `over-hard`.","type":"string"},"counting_mode":{"description":"Counting mode the numbers were computed under.","type":"string"},"policy_path":{"description":"Policy location of the limit.","type":"string"}},"required":["name","kind","scope","counted","state","counting_mode","policy_path"]}}},"SyncReconcileReceipt":{"$schema":"https://json-schema.org/draft/2020-12/schema","title":"SyncReconcileReceipt","description":"Versioned receipt for `br sync --reconcile` (`br.sync.reconcile.v1`).\n\nEmitted by both `--dry-run` (plan only, `applied: false`) and apply\n(`applied: true`, with the `apply` block present). Deletion is impossible\nin this mode, so `plan.deleted` is a constant `0`.","type":"object","properties":{"schema_version":{"description":"Receipt schema identifier (`br.sync.reconcile.v1`).","type":"string"},"mode":{"description":"`\"dry_run\"` or `\"apply\"`.","type":"string"},"applied":{"description":"True when the plan was applied to the database.","type":"boolean"},"jsonl_path":{"description":"Resolved JSONL path the plan was computed against.","type":"string"},"source":{"description":"Source (JSONL) witness the plan is bound to.","$ref":"#/$defs/ReconcileSourceWitness"},"target":{"description":"Target (database) witness the plan is bound to.","$ref":"#/$defs/ReconcileTargetWitness"},"plan":{"description":"Row classification counts.","$ref":"#/$defs/ReconcilePlanCounts"},"previews":{"description":"Bounded id previews for the classified sets.","$ref":"#/$defs/ReconcileIdPreviews"},"relations":{"description":"Relation rows carried by planned create/update rows.","$ref":"#/$defs/ReconcileRelationCounts"},"events_before":{"description":"Event rows before the operation.","type":"integer","format":"uint64","minimum":0},"events_after":{"description":"Event rows after the operation (always equals `events_before`; the\napply transaction rolls back otherwise).","type":"integer","format":"uint64","minimum":0},"apply":{"description":"Apply-only details; absent in dry-run receipts.","anyOf":[{"$ref":"#/$defs/ReconcileApplyReceipt"},{"type":"null"}]}},"required":["schema_version","mode","applied","jsonl_path","source","target","plan","previews","relations","events_before","events_after"],"$defs":{"ReconcileSourceWitness":{"description":"JSONL-side witness in a reconcile receipt.","type":"object","properties":{"record_count":{"description":"Non-empty JSONL rows parsed (including ephemeral rows).","type":"integer","format":"uint","minimum":0},"ephemeral_skipped":{"description":"Ephemeral (`-wisp-`) rows excluded from planning.","type":"integer","format":"uint","minimum":0},"content_hash":{"description":"Whitespace-normalized SHA-256 of the JSONL content.","type":"string"},"mtime":{"description":"RFC3339 mtime of the JSONL file at plan time.","type":"string"},"size_bytes":{"description":"Byte size of the JSONL file at plan time.","type":"integer","format":"uint64","minimum":0}},"required":["record_count","ephemeral_skipped","content_hash","mtime","size_bytes"]},"ReconcileTargetWitness":{"description":"Database-side witness in a reconcile receipt.","type":"object","properties":{"db_issue_count":{"description":"Total issue rows at plan time (including tombstones).","type":"integer","format":"uint","minimum":0},"stored_hash_matches_jsonl":{"description":"Whether the stored `jsonl_content_hash` metadata already matched the\nfile at plan time. True alongside nonzero `created`/`updated` counts\nis the false-equal state this mode repairs.","type":"boolean"}},"required":["db_issue_count","stored_hash_matches_jsonl"]},"ReconcilePlanCounts":{"description":"Row classification counts in a reconcile receipt.","type":"object","properties":{"created":{"description":"JSONL rows with no DB counterpart (inserted on apply).","type":"integer","format":"uint","minimum":0},"updated":{"description":"JSONL rows strictly newer than their DB counterpart (updated on apply).","type":"integer","format":"uint","minimum":0},"skipped_equal":{"description":"Rows skipped because timestamps are equal.","type":"integer","format":"uint","minimum":0},"skipped_older":{"description":"Rows skipped because the DB copy is strictly newer.","type":"integer","format":"uint","minimum":0},"skipped_tombstone":{"description":"Rows skipped by tombstone protection.","type":"integer","format":"uint","minimum":0},"deleted":{"description":"Always 0: additive reconciliation cannot delete.","type":"integer","format":"uint","minimum":0},"db_only":{"description":"Exportable DB issues absent from the JSONL row set (never touched).","type":"integer","format":"uint","minimum":0}},"required":["created","updated","skipped_equal","skipped_older","skipped_tombstone","deleted","db_only"]},"ReconcileIdPreviews":{"description":"Bounded id previews in a reconcile receipt.","type":"object","properties":{"created_ids":{"description":"First ids (sorted) that would be / were created.","type":"array","items":{"type":"string"}},"updated_ids":{"description":"First ids (sorted) that would be / were updated.","type":"array","items":{"type":"string"}},"db_only_ids":{"description":"First exportable DB-only ids (sorted).","type":"array","items":{"type":"string"}},"preview_limit":{"description":"Per-list truncation cap; counts in `plan` reflect true totals.","type":"integer","format":"uint","minimum":0}},"required":["created_ids","updated_ids","db_only_ids","preview_limit"]},"ReconcileRelationCounts":{"description":"Relation rows carried by planned create/update rows.","type":"object","properties":{"labels":{"description":"Label rows.","type":"integer","format":"uint","minimum":0},"dependencies":{"description":"Dependency rows.","type":"integer","format":"uint","minimum":0},"comments":{"description":"Comment rows.","type":"integer","format":"uint","minimum":0}},"required":["labels","dependencies","comments"]},"ReconcileApplyReceipt":{"description":"Apply-only block of a reconcile receipt.","type":"object","properties":{"export_hashes_recorded":{"description":"Export-hash rows recorded for rows whose DB copy now matches JSONL.","type":"integer","format":"uint","minimum":0},"uncertified_local_wins":{"description":"Skipped rows whose DB copy still differs from JSONL (local wins that\nneed a future flush).","type":"integer","format":"uint","minimum":0},"orphan_dependencies_cleaned":{"description":"Dangling dependency rows removed from just-written issues.","type":"integer","format":"uint","minimum":0},"blocked_cache_entries":{"description":"Blocked-cache rows after rebuild (0 when no row changed).","type":"integer","format":"uint","minimum":0},"child_counter_entries":{"description":"Child-counter rows after rebuild (0 when no row changed).","type":"integer","format":"uint","minimum":0},"needs_flush_set":{"description":"Whether `needs_flush` was set because local state still diverges from\nJSONL (db-only rows or uncertified local wins).","type":"boolean"},"metadata_repaired":{"description":"Whether import metadata (content hash + stat witness + import time)\nwas repaired in the apply transaction.","type":"boolean"}},"required":["export_hashes_recorded","uncertified_local_wins","orphan_dependencies_cleaned","blocked_cache_entries","child_counter_entries","needs_flush_set","metadata_repaired"]}}},"TreeNode":{"$schema":"https://json-schema.org/draft/2020-12/schema","title":"TreeNode","description":"Row emitted by `br dep tree --json`.\n\nKeep this in sync with `cli::commands::dep::TreeNode`. The command emits a\ncompact traversal node, not the older `format::output::TreeNode` shape that\nflattened a full `Issue`.","type":"object","properties":{"id":{"description":"Stable issue ID, external dependency ID, or missing-issue placeholder ID.","type":"string"},"title":{"description":"Human-readable title used in text/tree output.","type":"string"},"depth":{"description":"Depth from the requested root issue. The root is depth 0.","type":"integer","format":"uint","minimum":0},"parent_id":{"description":"Parent node issue ID, or null for the root.","type":["string","null"]},"priority":{"description":"Numeric issue priority used for sibling sorting.","type":"integer","format":"int32"},"status":{"description":"Issue status string, or synthesized status for external/missing nodes.","type":"string"},"truncated":{"description":"True when the node has children omitted by `--max-depth`.","type":"boolean"}},"required":["id","title","depth","parent_id","priority","status","truncated"]},"VcsExportStatus":{"$schema":"https://json-schema.org/draft/2020-12/schema","title":"VcsExportStatus","description":"Explicit Git visibility for the configured JSONL export.\n\nRepository and index evidence remains available when a path-local\nworktree comparison is unsafe or unsupported. Raw worktree identities are\ncomputed in-process from one immutable, no-follow JSONL snapshot; Git\nfilters and text conversions are never invoked.","type":"object","properties":{"schema":{"type":"string"},"requested":{"type":"boolean"},"available":{"type":"boolean"},"vcs":{"type":"string"},"observation_atomic":{"description":"False because HEAD, index, config, and worktree evidence are observed\nsequentially rather than under one transactional Git snapshot.","type":"boolean"},"path_scope":{"type":"string"},"path":{"type":"string"},"timeout_ms":{"type":"integer","format":"uint64","minimum":0},"duration_ms":{"type":"integer","format":"uint64","minimum":0},"reason":{"type":["string","null"]},"object_format":{"anyOf":[{"$ref":"#/$defs/GitObjectFormat"},{"type":"null"}]},"tracked":{"type":["boolean","null"]},"head":{"anyOf":[{"$ref":"#/$defs/GitPathIdentity"},{"type":"null"}]},"index":{"anyOf":[{"$ref":"#/$defs/GitPathIdentity"},{"type":"null"}]},"unmerged_index_stages":{"type":["array","null"],"items":{"$ref":"#/$defs/GitIndexStage"}},"index_clean":{"type":["boolean","null"]},"worktree_state":{"anyOf":[{"$ref":"#/$defs/WorktreeState"},{"type":"null"}]},"worktree_clean":{"type":["boolean","null"]},"worktree_comparison_reason":{"type":["string","null"]},"worktree_raw_git_blob_hash":{"type":["string","null"]},"worktree_raw_sha256":{"type":["string","null"]}},"required":["schema","requested","available","vcs","observation_atomic","path_scope","path","timeout_ms","duration_ms"],"$defs":{"GitObjectFormat":{"description":"Object format used by the selected Git repository.","type":"string","enum":["sha1","sha256"]},"GitPathIdentity":{"description":"Exact identity of one path in a Git tree or stage-zero index entry.","type":"object","properties":{"mode":{"type":"string"},"object_type":{"type":"string"},"object_id":{"type":"string"}},"required":["mode","object_type","object_id"]},"GitIndexStage":{"description":"Exact identity of one unmerged index stage.","type":"object","properties":{"stage":{"type":"integer","format":"uint8","minimum":0,"maximum":255},"mode":{"type":"string"},"object_type":{"type":"string"},"object_id":{"type":"string"}},"required":["stage","mode","object_type","object_id"]},"WorktreeState":{"description":"Relationship between the securely captured JSONL leaf and the Git index.","type":"string","enum":["clean","modified","deleted","untracked","ignored","unmerged","comparison_unavailable","absent"]}}}},"commands":{"blocked":{"shape":"array","jq_filter":".[]","items_at":".","item_schema":"BlockedIssue","error_envelope_on_stderr":false},"capabilities":{"shape":"object","jq_filter":".","error_envelope_on_stderr":false,"notes":"Machine-readable command, feature, safety, exit-code, and env-var inventory."},"comments list":{"shape":"array","jq_filter":".[]","items_at":".","error_envelope_on_stderr":true,"notes":"Empty array if no comments. ErrorEnvelope on stderr if the issue id cannot be resolved."},"coordination status":{"shape":"object","jq_filter":".claims[]","items_at":".claims","item_schema":"CoordinationClaimRow","error_envelope_on_stderr":false,"notes":"Read-only object with workspace summary and `claims[]` rows. The full envelope schema is `CoordinationStatusOutput`."},"count":{"shape":"object","jq_filter":".count","error_envelope_on_stderr":false,"notes":"Ungrouped `br count --json`; scalar count under `.count`. Grouped variants use the `count --by` entry."},"count --by":{"shape":"object","jq_filter":".groups[]","items_at":".groups","item_schema":"CountGroup","error_envelope_on_stderr":false,"notes":"For `br count --by <status|priority|type|assignee|label> --json`. The wrapper object also includes `total`."},"dep list":{"shape":"array","jq_filter":".[]","items_at":".","error_envelope_on_stderr":true},"dep tree":{"shape":"array","jq_filter":".[]","items_at":".","item_schema":"TreeNode","error_envelope_on_stderr":true,"notes":"Pre-order traversal; each node carries a `depth` field."},"info":{"shape":"object","jq_filter":".","error_envelope_on_stderr":false,"notes":"Workspace info object (paths, mode, config snapshot)."},"label list":{"shape":"array","jq_filter":".[]","items_at":".","error_envelope_on_stderr":false},"list":{"shape":"object","jq_filter":".issues[]","items_at":".issues","item_schema":"IssueWithCounts","error_envelope_on_stderr":false,"notes":"Wrapper object with pagination metadata; iterate with `.issues[]`. The wrapper exists so totals/cursors can ride alongside the rows."},"ready":{"shape":"array","jq_filter":".[]","items_at":".","item_schema":"ReadyIssue","error_envelope_on_stderr":false},"robot-docs guide":{"shape":"object","jq_filter":".","error_envelope_on_stderr":false,"notes":"JSON/TOON modes wrap the concise agent guide; text mode prints the guide directly."},"search":{"shape":"object","jq_filter":".issues[]","items_at":".issues","item_schema":"IssueWithCounts","error_envelope_on_stderr":false,"notes":"Stable wrapper object `{\"issues\": [...], \"hidden_closed_count\": N}`; iterate with `.issues[]`. The count is zero when no closed matches were hidden or the selected corpus already includes closed issues."},"show":{"shape":"array","jq_filter":".[0]","items_at":".","item_schema":"IssueDetails","error_envelope_on_stderr":true,"notes":"Always a single-element array on success (wrapped for shape consistency with list-style commands). On a missing id, an ErrorEnvelope is written to stderr and exit code is non-zero."},"stale":{"shape":"array","jq_filter":".[]","items_at":".","item_schema":"StaleIssue","error_envelope_on_stderr":false},"stats":{"shape":"object","jq_filter":".","item_schema":"Statistics","error_envelope_on_stderr":false,"notes":"Single aggregate object."},"status":{"shape":"object","jq_filter":".","item_schema":"Statistics","error_envelope_on_stderr":false,"notes":"Alias for `stats` — identical envelope."},"sync --reconcile-additive":{"shape":"object","jq_filter":".","item_schema":"AdditiveReconcileReceipt","error_envelope_on_stderr":false,"notes":"Dry-run by default. Apply requires the exact plan_sha256 from an identically configured reviewed dry-run via --expect-plan-sha256. Structured machine-mode errors are currently emitted on stdout."},"vcs-status":{"shape":"object","jq_filter":".","item_schema":"VcsExportStatus","error_envelope_on_stderr":false,"notes":"Explicit bounded read-only Git diagnostic. It is isolated from sync, retains HEAD/index evidence when worktree comparison is unavailable, never executes Git content filters, and reports sequential evidence with observation_atomic=false. Structured machine-mode errors are currently emitted on stdout."}}}
