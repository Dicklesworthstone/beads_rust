ent_sha256","source_storage_projection_sha256","source_size","source_mtime","poststate_timestamp","source_issues","target_before","expected_target_after","health_before","created","created_issue_ids","created_issue_ids_sha256","updated","updated_issue_ids","updated_issue_ids_sha256","requested_source_authoritative_issue_ids","requested_source_authoritative_issue_ids_sha256","source_authoritative_issue_ids","source_authoritative_issue_ids_sha256","scalar_updates","scalar_updates_sha256","content_hash_repairs_planned","content_hash_repairs","content_hash_repairs_sha256","content_hash_repair_issue_ids","content_hash_repair_issue_ids_sha256","content_hash_repairs_applied","skipped_equal","equal_issue_ids","equal_issue_ids_sha256","skipped_ephemeral","synchronized","export_hash_updates_planned","export_hashes_updated","dirty_markers_clear_planned","dirty_markers_cleared","conflicted","conflict_occurrences","deleted","db_only_preserved","db_only_issue_ids","db_only_issue_ids_sha256","conflict_reasons","conflict_issue_ids","conflict_issue_ids_sha256","conflict_issue_ids_truncated","conflict_witnesses","conflict_witnesses_sha256","conflict_scalar_diffs","conflict_scalar_diffs_sha256","conflict_relation_diffs","conflict_relation_diffs_sha256","comment_id_remaps","comment_id_remaps_sha256","preexisting_blocking_cycles","projected_blocking_cycles","new_blocking_cycles","relations_before","relations_after","relation_rows_planned","relation_rows_applied","expected_issue_raw_payload_sha256","expected_issue_semantic_payload_sha256","expected_issue_content_hash_payload_sha256","expected_export_hash_payload_sha256","expected_dirty_payload_sha256","expected_metadata_payload_sha256","expected_blocked_cache_payload_sha256","expected_child_counter_payload_sha256","expected_sqlite_sequence_payload_sha256","events_before","events_after","event_payload_sha256_before","event_payload_sha256_after","cache_rebuild_planned","cache_rebuild_performed","metadata_update_planned","metadata_changed","jsonl_written","base_snapshot_used","merge_note_written"],"$defs":{"AdditiveReconcileStatus":{"description":"Lifecycle state of a reconciliation receipt.","oneOf":[{"type":"string","enum":["conflicted","metadata_only_ready","no_changes","ready","applied_metadata_only","applied"]},{"description":"The transaction committed, but one or more independently reported\nsource, authority, or connection postconditions failed afterward.","type":"string","const":"committed_with_postcondition_failures"}]},"AdditivePostcommitFailure":{"description":"Independently composable failure observed only after SQLite committed.","type":"string","enum":["foreign_key_restoration","database_authority_changed","database_poststate_changed","workspace_authority_changed","source_witness_changed"]},"AdditiveDatabaseWitness":{"description":"Hash-bound read-only database witness used to reject stale apply plans.","type":"object","properties":{"issues":{"type":"integer","format":"uint","minimum":0},"issue_payload_sha256":{"description":"Digest of every raw issues-table column with explicit NULL framing.","type":"string"},"issue_semantic_payload_sha256":{"description":"Digest of the storage-semantic hydrated issue projection.","type":"string"},"issue_content_hashes":{"type":"integer","format":"uint","minimum":0},"issue_content_hash_payload_sha256":{"type":"string"},"relations":{"$ref":"#/$defs/AdditiveRelationCounts"},"label_payload_sha256":{"type":"string"},"dependency_payload_sha256":{"type":"string"},"comment_payload_sha256":{"type":"string"},"export_hashes":{"type":"integer","format":"uint","minimum":0},"export_hash_payload_sha256":{"type":"string"},"events":{"type":"integer","format":"uint","minimum":0},"event_payload_sha256":{"type":"string"},"dirty_issues":{"type":"integer","format":"uint","minimum":0},"dirty_payload_sha256":{"type":"string"},"metadata_rows":{"type":"integer","format":"uint","minimum":0},"metadata_payload_sha256":{"type":"string"},"stable_metadata":{"description":"Metadata that must remain stable while a committed merge finalizes its\nexport. This excludes only the pending-receipt row and the documented\nexport-bookkeeping keys.","$ref":"#/$defs/AdditiveTableWitness"},"blocked_cache_entries":{"type":"integer","format":"uint","minimum":0},"blocked_cache_payload_sha256":{"type":"string"},"child_counter_entries":{"type":"integer","format":"uint","minimum":0},"child_counter_payload_sha256":{"type":"string"},"config":{"$ref":"#/$defs/AdditiveTableWitness"},"close_metadata":{"$ref":"#/$defs/AdditiveTableWitness"},"gate_results":{"$ref":"#/$defs/AdditiveTableWitness"},"gate_result_history":{"$ref":"#/$defs/AdditiveTableWitness"},"schema_catalog":{"$ref":"#/$defs/AdditiveTableWitness"},"sqlite_sequence":{"$ref":"#/$defs/AdditiveTableWitness"},"stored_jsonl_content_hash":{"type":["string","null"]},"stored_jsonl_mtime":{"type":["string","null"]},"stored_jsonl_size":{"type":["string","null"]},"needs_flush":{"type":["string","null"]}},"required":["issues","issue_payload_sha256","issue_semantic_payload_sha256","issue_content_hashes","issue_content_hash_payload_sha256","relations","label_payload_sha256","dependency_payload_sha256","comment_payload_sha256","export_hashes","export_hash_payload_sha256","events","event_payload_sha256","dirty_issues","dirty_payload_sha256","metadata_rows","metadata_payload_sha256","stable_metadata","blocked_cache_entries","blocked_cache_payload_sha256","child_counter_entries","child_counter_payload_sha256","config","close_metadata","gate_results","gate_result_history","schema_catalog","sqlite_sequence"]},"AdditiveRelationCounts":{"description":"Relation-row counts captured around additive reconciliation.","type":"object","properties":{"labels":{"type":"integer","format":"uint","minimum":0},"dependencies":{"type":"integer","format":"uint","minimum":0},"comments":{"type":"integer","format":"uint","minimum":0}},"required":["labels","dependencies","comments"]},"AdditiveTableWitness":{"description":"Count and canonical payload digest for one complete database table.","type":"object","properties":{"rows":{"type":"integer","format":"uint","minimum":0},"payload_sha256":{"type":"string"}},"required":["rows","payload_sha256"]},"AdditiveDatabaseHealth":{"description":"Database-health gates captured before and after additive reconciliation.","type":"object","properties":{"integrity_messages":{"type":"array","items":{"type":"string"}},"foreign_key_violations":{"type":"array","items":{"type":"array","items":{"type":"string"}}}},"required":["integrity_messages","foreign_key_violations"]},"AdditiveScalarUpdateWitness":{"description":"Hash-bound scalar-only repair for a shared issue ID.","type":"object","properties":{"issue_id":{"type":"string"},"resolution":{"$ref":"#/$defs/AdditiveScalarResolution"},"changed_fields":{"type":"array","items":{"type":"string"}},"diff_sha256":{"type":"string"},"before_payload_sha256":{"type":"string"},"after_payload_sha256":{"type":"string"},"relation_payload_sha256":{"type":"string"}},"required":["issue_id","resolution","changed_fields","diff_sha256","before_payload_sha256","after_payload_sha256","relation_payload_sha256"]},"AdditiveScalarResolution":{"description":"Evidence-backed reason a shared issue's scalar fields may be updated.","type":"string","enum":["monotonic_closure","explicit_source_resolution"]},"AdditiveContentHashRepairWitness":{"description":"Exact before/after witness for a repaired persisted content hash.","type":"object","properties":{"issue_id":{"type":"string"},"before":{"type":["string","null"]},"after":{"type":"string"}},"required":["issue_id","after"]},"AdditiveConflictWitness":{"description":"Complete deterministic issue-to-reason conflict witness.","type":"object","properties":{"issue_id":{"type":"string"},"reasons":{"type":"array","items":{"type":"string"}},"details":{"type":"array","items":{"$ref":"#/$defs/AdditiveConflictDetailWitness"}}},"required":["issue_id","reasons","details"]},"AdditiveConflictDetailWitness":{"description":"Privacy-preserving, actionable evidence for one rejected source element.\n\nEmbedded relation values are not assumed to be validated issue IDs: an\nexternal target or malformed source can contain terminal control bytes or\na local path. All such related values, labels, external refs, dependency\nmetadata, and comment payloads are represented only by SHA-256.","type":"object","properties":{"reason":{"type":"string"},"detail_kind":{"type":"string"},"ordinal":{"type":["integer","null"],"format":"uint","minimum":0},"related_value_sha256":{"type":"array","items":{"type":"string"}},"validation_subcodes":{"type":"array","items":{"type":"string"}},"value_sha256":{"type":["string","null"]},"detail_sha256":{"type":"string"}},"required":["reason","detail_kind","detail_sha256"]},"AdditiveConflictScalarDiffWitness":{"description":"Complete hash-bound scalar difference for a shared issue that was refused.\n\nPayload bodies remain private; field names and before/after/diff hashes let\nan operator prove exactly which reviewed scalar conflict a token covered.","type":"object","properties":{"issue_id":{"type":"string"},"changed_fields":{"type":"array","items":{"type":"string"}},"diff_sha256":{"type":"string"},"before_payload_sha256":{"type":"string"},"after_payload_sha256":{"type":"string"}},"required":["issue_id","changed_fields","diff_sha256","before_payload_sha256","after_payload_sha256"]},"AdditiveConflictRelationDiffWitness":{"description":"Privacy-preserving relation delta for a shared issue that was refused.","type":"object","properties":{"issue_id":{"type":"string"},"changed_relation_classes":{"type":"array","items":{"type":"string"}},"before_counts":{"$ref":"#/$defs/AdditiveRelationCounts"},"after_counts":{"$ref":"#/$defs/AdditiveRelationCounts"},"before_payload_sha256":{"type":"string"},"after_payload_sha256":{"type":"string"},"added_element_sha256":{"type":"array","items":{"type":"string"}},"removed_element_sha256":{"type":"array","items":{"type":"string"}},"diff_sha256":{"type":"string"}},"required":["issue_id","changed_relation_classes","before_counts","after_counts","before_payload_sha256","after_payload_sha256","added_element_sha256","removed_element_sha256","diff_sha256"]},"AdditiveCommentIdRemap":{"description":"Deterministic remap of a storage-local comment surrogate ID.","type":"object","properties":{"issue_id":{"type":"string"},"old_id":{"type":"integer","format":"int64"},"new_id":{"type":"integer","format":"int64"},"logical_payload_sha256":{"type":"string"}},"required":["issue_id","old_id","new_id","logical_payload_sha256"]}}},"BlockedIssue":{"$schema":"https://json-schema.org/draft/2020-12/schema","title":"BlockedIssueOutput","description":"Minimal issue output for blocked command (bd parity).\n\nContains only the fields that bd's blocked command outputs, plus `blocked_by` info.\nDoes NOT include: `compaction_level`, `original_size`","type":"object","properties":{"blocked_by":{"type":"array","items":{"type":"string"}},"blocked_by_count":{"type":"integer","format":"uint","minimum":0},"created_at":{"type":"string","format":"date-time"},"created_by":{"type":["string","null"]},"description":{"type":["string","null"]},"id":{"type":"string"},"issue_type":{"$ref":"#/$defs/IssueType"},"priority":{"$ref":"#/$defs/Priority"},"status":{"$ref":"#/$defs/Status"},"title":{"type":"string"},"updated_at":{"type":"string","format":"date-time"}},"required":["blocked_by","blocked_by_count","created_at","id","issue_type","priority","status","title","updated_at"],"$defs":{"IssueType":{"description":"Issue type category.","anyOf":[{"type":"string","enum":["task","bug","feature","epic","chore","docs","question"]},{"type":"string"}]},"Priority":{"description":"Issue priority (0=Critical, 4=Backlog).","type":"integer","format":"int32"},"Status":{"description":"Issue lifecycle status.","anyOf":[{"type":"string","enum":["open","in_progress","blocked","deferred","draft","closed","tombstone","pinned"]},{"type":"string"}]}}},"CoordinationClaimRow":{"$schema":"https://json-schema.org/draft/2020-12/schema","title":"CoordinationClaimRow","description":"One in-progress issue plus its deterministic coordination assessment.","type":"object","properties":{"issue":{"$ref":"#/$defs/CoordinationIssueRow"},"agent":{"anyOf":[{"$ref":"#/$defs/AgentMailAgentSnapshot"},{"type":"null"}]},"assessment":{"$ref":"#/$defs/ClaimAssessment"},"reclaim_allowed_by_policy":{"type":"boolean"},"required_human_confirmation":{"type":"boolean"},"evidence_summary":{"type":"string"},"suggested_commands":{"type":"array","items":{"$ref":"#/$defs/CoordinationSuggestedCommand"}}},"required":["issue","assessment","reclaim_allowed_by_policy","required_human_confirmation","evidence_summary","suggested_commands"],"$defs":{"CoordinationIssueRow":{"description":"Issue context attached to one coordination claim row.","type":"object","properties":{"id":{"type":"string"},"title":{"type":"string"},"status":{"$ref":"#/$defs/Status"},"priority":{"$ref":"#/$defs/Priority"},"issue_type":{"$ref":"#/$defs/IssueType"},"labels":{"type":"array","items":{"type":"string"}},"dependency_count":{"type":"integer","format":"uint","minimum":0},"dependent_count":{"type":"integer","format":"uint","minimum":0},"latest_comments":{"type":"array","items":{"$ref":"#/$defs/CoordinationComment"}}},"required":["id","title","status","priority","issue_type","labels","dependency_count","dependent_count","latest_comments"]},"Status":{"description":"Issue lifecycle status.","anyOf":[{"type":"string","enum":["open","in_progress","blocked","deferred","draft","closed","tombstone","pinned"]},{"type":"string"}]},"Priority":{"description":"Issue priority (0=Critical, 4=Backlog).","type":"integer","format":"int32"},"IssueType":{"description":"Issue type category.","anyOf":[{"type":"string","enum":["task","bug","feature","epic","chore","docs","question"]},{"type":"string"}]},"CoordinationComment":{"description":"Bounded comment excerpt included with a coordination claim row.","type":"object","properties":{"author":{"type":"string"},"text":{"type":"string"},"created_at":{"type":"string","format":"date-time"}},"required":["author","text","created_at"]},"AgentMailAgentSnapshot":{"description":"Minimal offline agent-liveness snapshot row exported from Agent Mail.","type":"object","properties":{"name":{"type":"string"},"task_description":{"type":"string"},"last_active_ts":{"type":"string","format":"date-time"},"contact_policy":{"type":"string"}},"required":["name","task_description","last_active_ts","contact_policy"]},"ClaimAssessment":{"description":"Deterministic assessment for one in-progress claim.","type":"object","properties":{"assignee":{"type":["string","null"]},"owner_kind":{"$ref":"#/$defs/ClaimOwnerKind"},"updated_at":{"type":"string","format":"date-time"},"updated_age_minutes":{"type":"integer","format":"int64"},"stale_threshold_minutes":{"type":"integer","format":"int64"},"abandoned_threshold_minutes":{"type":"integer","format":"int64"},"reservation":{"$ref":"#/$defs/ReservationEvidence"},"classification":{"$ref":"#/$defs/ClaimClassification"},"recommended_action":{"$ref":"#/$defs/RecommendedAction"},"evidence_sources":{"type":"array","items":{"$ref":"#/$defs/CoordinationEvidenceSource"}}},"required":["owner_kind","updated_at","updated_age_minutes","stale_threshold_minutes","abandoned_threshold_minutes","reservation","classification","recommended_action","evidence_sources"]},"ClaimOwnerKind":{"description":"Who appears to own the current claim.","oneOf":[{"description":"A named coding-agent swarm participant.","type":"string","const":"swarm_agent"},{"description":"A human assignee or operator-owned claim.","type":"string","const":"human"},{"description":"Ownership cannot be confidently classified.","type":"string","const":"unknown"}]},"ReservationEvidence":{"description":"Optional Agent Mail reservation evidence supplied by the caller.","oneOf":[{"description":"No Agent Mail snapshot was supplied, so absence of reservations is not\nevidence of abandonment.","type":"object","properties":{"state":{"type":"string","const":"no_snapshot"}},"required":["state"]},{"description":"A snapshot was supplied and no matching reservation was found.","type":"object","properties":{"state":{"type":"string","const":"no_reservation"}},"required":["state"]},{"description":"A matching active reservation exists.","type":"object","properties":{"state":{"type":"string","const":"active"},"detail":{"type":"object","properties":{"holder":{"type":"string"},"expires_at":{"type":["string","null"],"format":"date-time"},"provenance":{"anyOf":[{"$ref":"#/$defs/ReservationEvidenceProvenance"},{"type":"null"}]}},"required":["holder"]}},"required":["state","detail"]},{"description":"A matching reservation exists but is no longer active.","type":"object","properties":{"state":{"type":"string","const":"expired"},"detail":{"type":"object","properties":{"holder":{"type":"string"},"released_at":{"type":["string","null"],"format":"date-time"},"provenance":{"anyOf":[{"$ref":"#/$defs/ReservationEvidenceProvenance"},{"type":"null"}]}},"required":["holder"]}},"required":["state","detail"]},{"description":"Snapshot data was supplied but could not be trusted.","type":"object","properties":{"state":{"type":"string","const":"invalid_snapshot"},"detail":{"type":"object","properties":{"reason":{"type":"string"}},"required":["reason"]}},"required":["state","detail"]}]},"ReservationEvidenceProvenance":{"description":"Provenance copied from a matching reservation snapshot.","type":"object","properties":{"path_pattern":{"type":"string"},"exclusive":{"type":"boolean"},"reason":{"type":["string","null"]},"expires_ts":{"type":"string","format":"date-time"},"released_ts":{"type":["string","null"],"format":"date-time"},"thread_id":{"type":["string","null"]},"matched_on":{"type":"array","items":{"$ref":"#/$defs/ReservationSnapshotMatchReason"}}},"required":["path_pattern","exclusive","expires_ts","matched_on"]},"ReservationSnapshotMatchReason":{"description":"Why an Agent Mail reservation snapshot was associated with an issue.","oneOf":[{"description":"Reservation holder matches the issue assignee.","type":"string","const":"holder_matches_assignee"},{"description":"Reservation reason or thread id names the issue id.","type":"string","const":"issue_id"},{"description":"A recent issue comment names the reservation path pattern.","type":"string","const":"comment_path"}]},"ClaimClassification":{"description":"Stable claim classifications used by coordination-aware surfaces.","oneOf":[{"description":"The issue is in progress but has no meaningful assignee.","type":"string","const":"unassigned"},{"description":"The claim is still within the owner-specific freshness window.","type":"string","const":"fresh"},{"description":"A live reservation exists, so the claim must not be treated as abandoned.","type":"string","const":"blocked_by_active_reservation"},{"description":"The claim has crossed the stale threshold and no active reservation was\nfound in a supplied snapshot.","type":"string","const":"stale_candidate"},{"description":"The claim has crossed a more conservative abandoned threshold.","type":"string","const":"abandoned_likely"},{"description":"The claim is old enough to inspect, but no Agent Mail snapshot was\nsupplied.","type":"string","const":"no_mail_snapshot"},{"description":"Evidence conflicts or cannot be trusted.","type":"string","const":"ambiguous"}]},"RecommendedAction":{"description":"Suggested next action for an operator or agent.","oneOf":[{"description":"Do nothing except continue normal observation.","type":"string","const":"observe"},{"description":"Ask the assignee or human operator before touching the claim.","type":"string","const":"ask_owner"},{"description":"Inspect Agent Mail reservations or capture a fresh snapshot.","type":"string","const":"inspect_mail"},{"description":"The issue is a candidate for the documented audit-comment plus claim\nsequence. This is still advisory, not an automatic mutation.","type":"string","const":"reclaim_candidate"},{"description":"Leave the claim alone because evidence says work may still be active.","type":"string","const":"leave_active"}]},"CoordinationEvidenceSource":{"description":"Evidence categories present in a claim assessment.","oneOf":[{"description":"Issue status, assignee, and updated timestamp.","type":"string","const":"issue_metadata"},{"description":"Owner-specific stale and abandoned thresholds.","type":"string","const":"policy_threshold"},{"description":"A caller-supplied Agent Mail snapshot.","type":"string","const":"agent_mail_snapshot"},{"description":"Explicit absence of an Agent Mail snapshot.","type":"string","const":"no_agent_mail_snapshot"}]},"CoordinationSuggestedCommand":{"description":"A command suggestion emitted for an operator to review and run manually.","type":"object","properties":{"purpose":{"$ref":"#/$defs/CoordinationSuggestedCommandPurpose"},"command":{"type":"string"}},"required":["purpose","command"]},"CoordinationSuggestedCommandPurpose":{"description":"Role for a suggested coordination command.","oneOf":[{"description":"Record the reclaim evidence before touching ownership.","type":"string","const":"add_reclaim_audit_comment"},{"description":"Claim the issue after the audit comment is recorded.","type":"string","const":"claim_issue"}]}}},"CoordinationStatusOutput":{"$schema":"https://json-schema.org/draft/2020-12/schema","title":"CoordinationStatusOutput","description":"Top-level machine-readable coordination status shape.","type":"object","properties":{"schema_version":{"type":"string"},"generated_at":{"type":"string","format":"date-time"},"summary":{"$ref":"#/$defs/CoordinationSummary"},"claims":{"type":"array","items":{"$ref":"#/$defs/CoordinationClaimRow"}},"capacity":{"description":"Workflow capacity occupancy (GitHub #384 phase 6). Absent when no\ncapacity is configured, preserving the pre-capacity\n`br.coordination.v1` payload shape.","type":"array","items":{"$ref":"#/$defs/CapacityStat"}}},"required":["schema_version","generated_at","summary","claims"],"$defs":{"CoordinationSummary":{"description":"Count summary for coordination status output.","type":"object","properties":{"total_claims":{"type":"integer","format":"uint","minimum":0},"workspace":{"$ref":"#/$defs/CoordinationWorkspaceCounts"},"unassigned":{"type":"integer","format":"uint","minimum":0},"fresh":{"type":"integer","format":"uint","minimum":0},"blocked_by_active_reservation":{"type":"integer","format":"uint","minimum":0},"stale_candidate":{"type":"integer","format":"uint","minimum":0},"abandoned_likely":{"type":"integer","format":"uint","minimum":0},"no_mail_snapshot":{"type":"integer","format":"uint","minimum":0},"ambiguous":{"type":"integer","format":"uint","minimum":0}},"required":["total_claims","workspace","unassigned","fresh","blocked_by_active_reservation","stale_candidate","abandoned_likely","no_mail_snapshot","ambiguous"]},"CoordinationWorkspaceCounts":{"description":"Workspace context counts shown next to hidden-claim diagnosis.","type":"object","properties":{"open":{"type":"integer","format":"uint","minimum":0},"ready":{"type":"integer","format":"uint","minimum":0},"blocked":{"type":"integer","format":"uint","minimum":0},"in_progress":{"type":"integer","format":"uint","minimum":0},"deferred":{"type":"integer","format":"uint","minimum":0},"closed":{"type":"integer","format":"uint","minimum":0}},"required":["open","ready","blocked","in_progress","deferred","closed"]},"CoordinationClaimRow":{"description":"One in-progress issue plus its deterministic coordination assessment.","type":"object","properties":{"issue":{"$ref":"#/$defs/CoordinationIssueRow"},"agent":{"anyOf":[{"$ref":"#/$defs/AgentMailAgentSnapshot"},{"type":"null"}]},"assessment":{"$ref":"#/$defs/ClaimAssessment"},"reclaim_allowed_by_policy":{"type":"boolean"},"required_human_confirmation":{"type":"boolean"},"evidence_summary":{"type":"string"},"suggested_commands":{"type":"array","items":{"$ref":"#/$defs/CoordinationSuggestedCommand"}}},"required":["issue","assessment","reclaim_allowed_by_policy","required_human_confirmation","evidence_summary","suggested_commands"]},"CoordinationIssueRow":{"description":"Issue context attached to one coordination claim row.","type":"object","properties":{"id":{"type":"string"},"title":{"type":"string"},"status":{"$ref":"#/$defs/Status"},"priority":{"$ref":"#/$defs/Priority"},"issue_type":{"$ref":"#/$defs/IssueType"},"labels":{"type":"array","items":{"type":"string"}},"dependency_count":{"type":"integer","format":"uint","minimum":0},"dependent_count":{"type":"integer","format":"uint","minimum":0},"latest_comments":{"type":"array","items":{"$ref":"#/$defs/CoordinationComment"}}},"required":["id","title","status","priority","issue_type","labels","dependency_count","dependent_count","latest_comments"]},"Status":{"description":"Issue lifecycle status.","anyOf":[{"type":"string","enum":["open","in_progress","blocked","deferred","draft","closed","tombstone","pinned"]},{"type":"string"}]},"Priority":{"description":"Issue priority (0=Critical, 4=Backlog).","type":"integer","format":"int32"},"IssueType":{"description":"Issue type category.","anyOf":[{"type":"string","enum":["task","bug","feature","epic","chore","docs","question"]},{"type":"string"}]},"CoordinationComment":{"description":"Bounded comment excerpt included with a coordination claim row.","type":"object","properties":{"author":{"type":"string"},"text":{"type":"string"},"created_at":{"type":"string","format":"date-time"}},"required":["author","text","created_at"]},"AgentMailAgentSnapshot":{"description":"Minimal offline agent-liveness snapshot row exported from Agent Mail.","type":"object","properties":{"name":{"type":"string"},"task_description":{"type":"string"},"last_active_ts":{"type":"string","format":"date-time"},"contact_policy":{"type":"string"}},"required":["name","task_description","last_active_ts","contact_policy"]},"ClaimAssessment":{"description":"Deterministic assessment for one in-progress claim.","type":"object","properties":{"assignee":{"type":["string","null"]},"owner_kind":{"$ref":"#/$defs/ClaimOwnerKind"},"updated_at":{"type":"string","format":"date-time"},"updated_age_minutes":{"type":"integer","format":"int64"},"stale_threshold_minutes":{"type":"integer","format":"int64"},"abandoned_threshold_minutes":{"type":"integer","format":"int64"},"reservation":{"$ref":"#/$defs/ReservationEvidence"},"classification":{"$ref":"#/$defs/ClaimClassification"},"recommended_action":{"$ref":"#/$defs/RecommendedAction"},"evidence_sources":{"type":"array","items":{"$ref":"#/$defs/CoordinationEvidenceSource"}}},"required":["owner_kind","updated_at","updated_age_minutes","stale_threshold_minutes","abandoned_threshold_minutes","reservation","classification","recommended_action","evidence_sources"]},"ClaimOwnerKind":{"description":"Who appears to own the current claim.","oneOf":[{"description":"A named coding-agent swarm participant.","type":"string","const":"swarm_agent"},{"description":"A human assignee or operator-owned claim.","type":"string","const":"human"},{"description":"Ownership cannot be confidently classified.","type":"string","const":"unknown"}]},"ReservationEvidence":{"description":"Optional Agent Mail reservation evidence supplied by the caller.","oneOf":[{"description":"No Agent Mail snapshot was supplied, so absence of reservations is not\nevidence of abandonment.","type":"object","properties":{"state":{"type":"string","const":"no_snapshot"}},"required":["state"]},{"description":"A snapshot was supplied and no matching reservation was found.","type":"object","properties":{"state":{"type":"string","const":"no_reservation"}},"required":["state"]},{"description":"A matching active reservation exists.","type":"object","properties":{"state":{"type":"string","const":"active"},"detail":{"type":"object","properties":{"holder":{"type":"string"},"expires_at":{"type":["string","null"],"format":"date-time"},"provenance":{"anyOf":[{"$ref":"#/$defs/ReservationEvidence