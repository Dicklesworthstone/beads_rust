{"tool":"br","generated_at": "GENERATED_AT","schemas":{"AdditiveReconcileReceipt":{"$schema":"https://json-schema.org/draft/2020-12/schema","title":"AdditiveReconcileReceipt","description":"Complete hash-bound result for additive reconciliation planning/apply.","type":"object","properties":{"schema":{"type":"string"},"algorithm":{"type":"string"},"tool_version":{"type":"string"},"plan_sha256":{"type":"string"},"status":{"$ref":"#/$defs/AdditiveReconcileStatus"},"workspace_path":{"type":"string"},"workspace_path_sha256":{"type":"string"},"workspace_identity_sha256":{"type":"string"},"source_path":{"type":"string"},"source_path_sha256":{"type":"string"},"source_identity_sha256":{"type":"string"},"database_path":{"type":"string"},"database_path_sha256":{"type":"string"},"database_identity_sha256":{"type":["string","null"]},"write_lock_authority":{"type":"string"},"write_lock_authority_sha256":{"type":"string"},"database_authority_preserved_after_commit":{"type":["boolean","null"]},"database_poststate_preserved_after_commit":{"type":["boolean","null"]},"workspace_authority_preserved_after_commit":{"type":["boolean","null"]},"source_preserved_after_commit":{"type":["boolean","null"]},"foreign_keys_restored_after_commit":{"type":["boolean","null"]},"postcommit_failures":{"type":"array","items":{"$ref":"#/$defs/AdditivePostcommitFailure"}},"database_user_version":{"type":"integer","format":"uint32","minimum":0},"project_prefix":{"type":["string","null"]},"source_raw_sha256":{"description":"SHA-256 of the exact source bytes.","type":"string"},"source_content_sha256":{"description":"SHA-256 of trimmed nonblank JSONL records with canonical LF framing.","type":"string"},"source_storage_projection_sha256":{"description":"SHA-256 of the deterministic storage-semantic projection of all source issues.","type":"string"},"source_size":{"type":"integer","format":"uint64","minimum":0},"source_mtime":{"type":"string"},"poststate_timestamp":{"description":"Deterministic timestamp used for recovery-owned bookkeeping rows.\nEqual to the reviewed source snapshot mtime.","type":"string"},"source_issues":{"type":"integer","format":"uint","minimum":0},"target_before":{"$ref":"#/$defs/AdditiveDatabaseWitness"},"expected_target_after":{"$ref":"#/$defs/AdditiveDatabaseWitness"},"target_after":{"anyOf":[{"$ref":"#/$defs/AdditiveDatabaseWitness"},{"type":"null"}]},"health_before":{"$ref":"#/$defs/AdditiveDatabaseHealth"},"health_after":{"anyOf":[{"$ref":"#/$defs/AdditiveDatabaseHealth"},{"type":"null"}]},"created":{"type":"integer","format":"uint","minimum":0},"created_issue_ids":{"type":"array","items":{"type":"string"}},"created_issue_ids_sha256":{"type":"string"},"updated":{"type":"integer","format":"uint","minimum":0},"updated_issue_ids":{"type":"array","items":{"type":"string"}},"updated_issue_ids_sha256":{"type":"string"},"requested_source_authoritative_issue_ids":{"description":"Exact override set supplied by the operator, whether or not each ID was applicable.","type":"array","items":{"type":"string"}},"requested_source_authoritative_issue_ids_sha256":{"type":"string"},"source_authoritative_issue_ids":{"description":"Applicable overrides actually used by this plan.","type":"array","items":{"type":"string"}},"source_authoritative_issue_ids_sha256":{"type":"string"},"scalar_updates":{"type":"array","items":{"$ref":"#/$defs/AdditiveScalarUpdateWitness"}},"scalar_updates_sha256":{"type":"string"},"content_hash_repairs_planned":{"type":"integer","format":"uint","minimum":0},"content_hash_repairs":{"type":"array","items":{"$ref":"#/$defs/AdditiveContentHashRepairWitness"}},"content_hash_repairs_sha256":{"type":"string"},"content_hash_repair_issue_ids":{"type":"array","items":{"type":"string"}},"content_hash_repair_issue_ids_sha256":{"type":"string"},"content_hash_repairs_applied":{"type":"integer","format":"uint","minimum":0},"skipped_equal":{"type":"integer","format":"uint","minimum":0},"equal_issue_ids":{"type":"array","items":{"type":"string"}},"equal_issue_ids_sha256":{"type":"string"},"skipped_ephemeral":{"type":"integer","format":"uint","minimum":0},"synchronized":{"description":"Source issues proven equal to, created in, or updated in SQLite.","type":"integer","format":"uint","minimum":0},"export_hash_updates_planned":{"type":"integer","format":"uint","minimum":0},"export_hashes_updated":{"type":"integer","format":"uint","minimum":0},"dirty_markers_clear_planned":{"type":"integer","format":"uint","minimum":0},"dirty_markers_cleared":{"type":"integer","format":"uint","minimum":0},"conflicted":{"description":"Number of distinct issues involved in one or more conflicts.","type":"integer","format":"uint","minimum":0},"conflict_occurrences":{"description":"Total conflict observations across all reason buckets.","type":"integer","format":"uint","minimum":0},"deleted":{"type":"integer","format":"uint","minimum":0},"db_only_preserved":{"type":"integer","format":"uint","minimum":0},"db_only_issue_ids":{"type":"array","items":{"type":"string"}},"db_only_issue_ids_sha256":{"type":"string"},"conflict_reasons":{"type":"object","additionalProperties":{"type":"integer","format":"uint","minimum":0}},"conflict_issue_ids":{"type":"array","items":{"type":"string"}},"conflict_issue_ids_sha256":{"type":"string"},"conflict_issue_ids_truncated":{"type":"boolean"},"conflict_witnesses":{"type":"array","items":{"$ref":"#/$defs/AdditiveConflictWitness"}},"conflict_witnesses_sha256":{"type":"string"},"conflict_scalar_diffs":{"type":"array","items":{"$ref":"#/$defs/AdditiveConflictScalarDiffWitness"}},"conflict_scalar_diffs_sha256":{"type":"string"},"conflict_relation_diffs":{"type":"array","items":{"$ref":"#/$defs/AdditiveConflictRelationDiffWitness"}},"conflict_relation_diffs_sha256":{"type":"string"},"comment_id_remaps":{"type":"array","items":{"$ref":"#/$defs/AdditiveCommentIdRemap"}},"comment_id_remaps_sha256":{"type":"string"},"preexisting_blocking_cycles":{"description":"Blocking-cycle components already present in the database.","